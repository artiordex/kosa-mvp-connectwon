# 로그 및 진단 파일
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# 런타임 / 프로세스 관련

pids
*.pid
*.seed
*.pid.lock

# 빌드 및 커버리지 결과
lib-cov
coverage
*.lcov
.nyc_output
build/
dist/
dist/apps/
dist/packages/

