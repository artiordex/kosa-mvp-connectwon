/**
 * Description : tsconfig.base.json - 📌 루트 TypeScript 공통 설정 (호이스팅 적용)
 * Author : Shiwoo Min
 * Date : 2025-09-06
 * 09-17 : paths에 apps, packages 전체 추가
 * 09-20 : paths를 compilerOptions 내부로 이동, 중복 baseUrl 제거
 * 09-28 : paths를 src + dist 이중 매핑으로 변경 (배포/로컬 모두 지원)
 * 컴파일러 가능한 상태인지 확인:
 *   pnpm -w exec tsc --noEmit --showConfig > /dev/null
 */
{
  "compilerOptions": {
    // 절대경로 import를 위한 기준 디렉터리
    "baseUrl": ".",

    // 런타임 타깃/라이브러리 (Node.js 18+)
    "target": "ES2022",

    // 서버/라이브러리 기본값 (ESM/Node.js)
    "module": "NodeNext",

    // 패키지 exports/확장자 규칙 (NodeNext)
    "moduleResolution": "NodeNext",

    // 서버/라이브러리 공통은 ES 표준
    "lib": ["ES2022"],

    // 타입 검사 관련
    "strict": true,

    // 외부 d.ts 스킵
    "skipLibCheck": true,

    // JSON 모듈 임포트 허용
    "resolveJsonModule": true,

    // TS5 ESM 감지 강화
    "moduleDetection": "force",

    // CJS/ESM 상호운용
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    // import/export 구문 그대로 보존
    "verbatimModuleSyntax": true,

    // 대소문자 일관성 검사
    "forceConsistentCasingInFileNames": true,

    // 디버깅 지원
    "sourceMap": true,
    "inlineSources": false,

    // JS 파일도 컴파일
    "allowJs": true,
    "checkJs": false,

    // Project References / 빌드 캐시
    "declaration": true,
    "declarationMap": true,
    "isolatedModules": true,
    "incremental": true,
    "composite": true,

    // 엄격 옵션
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    /**
     * 경로 매핑 (packages / apps)
     * dev 환경(src) + build 환경(dist) 이중 매핑
     */
    "paths": {
      // Core
      "@connectwon/core": [
        // "packages/core/src/index.ts",
        "dist/packages/core/src/index.d.ts"
      ],
      "@connectwon/core/*": [
        // "packages/core/src/*",
        "dist/packages/core/src/*"
      ],

      // Config
      "@connectwon/configs": [
        // "packages/configs/src/index.ts",
        "dist/packages/configs/src/index.d.ts"
      ],
      "@connectwon/configs/*": [
        // "packages/configs/src/*",
        "dist/packages/configs/src/*"
      ],

      // Database
      "@connectwon/database": [
        // "packages/database/src/index.ts",
        "dist/packages/database/src/index.d.ts"
      ],
      "@connectwon/database/*": [
        // "packages/database/src/*",
        "dist/packages/database/src/*"
      ],

      // Logger
      "@connectwon/logger": [
        // "packages/logger/src/index.ts",
        "dist/packages/logger/src/index.d.ts"
      ],
      "@connectwon/logger/*": [
        // "packages/logger/src/*",
        "dist/packages/logger/src/*"
      ],

      // UI
      "@connectwon/ui": [
        // "packages/ui/src/index.ts",
        "dist/packages/ui/src/index.d.ts"
      ],
      "@connectwon/ui/*": [
        // "packages/ui/src/*",
        "dist/packages/ui/src/*"
      ],

      // Client
      "@connectwon/client": [
        // "packages/client/src/index.ts",
        "dist/packages/client/src/index.d.ts"
      ],
      "@connectwon/client/*": [
        // "packages/client/src/*",
        "dist/packages/client/src/*"
      ],

      // SDK
      "@connectwon/sdk": [
        // "packages/sdk/typescript/src",
        "dist/packages/sdk/src/index.d.ts"
      ],
      "@connectwon/sdk/*": [
        // "packages/sdk/typescript/src/*",
        "dist/packages/sdk/src/*"
      ],

      // API Contract
      "@connectwon/api-contract": [
        // "packages/api-contract/src",
        "dist/packages/api-contract/src/index.d.ts"
      ],
      "@connectwon/api-contract/*": [
        // "packages/api-contract/src/*",
        "dist/packages/api-contract/src/*"
      ],

      // Server
      "@connectwon/server": [
        // "packages/server/src/index.ts",
        "dist/packages/server/src/index.d.ts"
      ],
      "@connectwon/server/*": [
        // "packages/server/src/*",
        "dist/packages/server/src/*"
      ],

      // Web
      "@connectwon/web": [
        // "apps/web/src",
        "dist/apps/web/src"
      ],
      "@connectwon/web/*": [
        // "apps/web/src/*",
        "dist/apps/web/src/*"
      ],

      // Admin
      "@connectwon/admin": [
        // "apps/admin/src",
        "dist/apps/admin/src"
      ],
      "@connectwon/admin/*": [
        // "apps/admin/src/*",
        "dist/apps/admin/src/*"
      ],

      // Api
      "@connectwon/api": [
        // "apps/api/src",
        "dist/apps/api/src"
      ],
      "@connectwon/api/*": [
        // "apps/api/src/*",
        "dist/apps/api/src/*"
      ],

      // Worker
      "@connectwon/worker": [
        // "apps/worker/src",
        "dist/apps/worker/src"
      ],
      "@connectwon/worker/*": [
        // "apps/worker/src/*",
        "dist/apps/worker/src/*"
      ],

      // E2E
      "@connectwon/e2e": [
        // "apps/e2e/src",
        "dist/apps/e2e/src"
      ],
      "@connectwon/e2e/*": [
        // "apps/e2e/src/*",
        "dist/apps/e2e/src/*"
      ]
    }
  }
}
