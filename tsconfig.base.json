/**
 * Description : tsconfig.base.json - 📌 루트 TypeScript 공통 설정 (호이스팅 적용)
 * Author : Shiwoo Min
 * Date : 2025-09-06
 * 09-17 - paths에 apps, packages 전체 추가
 * 09-20 - paths를 compilerOptions 내부로 이동, 중복 baseUrl 제거
 * 컴파일러 가능한 상태인지 확인 - pnpm -w exec tsc --noEmit --showConfig > /dev/null
 */
{
  "compilerOptions": {
    // 절대경로 import를 위한 기준 디렉터리
    "baseUrl": ".",

    // 런타임 타깃/라이브러리 (Node.js 18+)
    "target": "ES2022",

    // 서버/라이브러리 기본값 (ESM/Node.js)
    "module": "NodeNext",

    // 패키지 exports/확장자 규칙 (NodeNext)
    "moduleResolution": "NodeNext",

    // 서버/라이브러리 공통은 ES 표준
    "lib": ["ES2022"],

    // 타입 검사 관련
    "strict": true,

    // 외부 d.ts 스킵
    "skipLibCheck": true,

    // JSON 모듈 임포트 허용
    "resolveJsonModule": true,

    // 암묵적 ESM 감지 강화
    "moduleDetection": "force",

    // CJS/ESM 상호운용
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    // import/export 구문 그대로 보존
    "verbatimModuleSyntax": true,

    // 대소문자 일관성 검사
    "forceConsistentCasingInFileNames": true,

    // 디버깅 지원
    "sourceMap": true,
    "inlineSources": false,

    // JS 파일도 컴파일
    "allowJs": true,
    "checkJs": false,

    // Project References
    "declaration": true,
    "declarationMap": true,
    "isolatedModules": true,
    "incremental": true,
    "composite": true,

    // 엄격 옵션
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    // 경로 매핑 (packages / apps)
    "paths": {
      // packages
      "@connectwon/core": ["packages/core/src"],
      "@connectwon/core/*": ["packages/core/src/*"],
      "@connectwon/api-contract": ["packages/api-contract/src"],
      "@connectwon/api-contract/*": ["packages/api-contract/src/*"],
      "@connectwon/configs": ["packages/configs/src"],
      "@connectwon/configs/*": ["packages/configs/src/*"],

      "@connectwon/logger": ["packages/logger/src"],
      "@connectwon/logger/*": ["packages/logger/src/*"],
      "@connectwon/sdk": ["packages/sdk/src"],
      "@connectwon/sdk/*": ["packages/sdk/src/*"],
      "@connectwon/client": ["packages/client/src"],
      "@connectwon/client/*": ["packages/client/src/*"],
      "@connectwon/ui": ["packages/ui/src"],
      "@connectwon/ui/*": ["packages/ui/src/*"],

      // apps
      "@connectwon/web": ["apps/web/src"],
      "@connectwon/web/*": ["apps/web/src/*"],
      "@connectwon/admin": ["apps/admin/src"],
      "@connectwon/admin/*": ["apps/admin/src/*"],
      "@connectwon/api": ["apps/api/src"],
      "@connectwon/api/*": ["apps/api/src/*"],
      "@connectwon/worker": ["apps/worker/src"],
      "@connectwon/worker/*": ["apps/worker/src/*"],
      "@connectwon/e2e": ["apps/e2e/src"],
      "@connectwon/e2e/*": ["apps/e2e/src/*"],

      // server 엔트리포인트를 index.ts로 명확히 지정
      "@connectwon/server": ["packages/server/src/index.ts"],
      "@connectwon/server/*": ["packages/server/src/*"],
      "@connectwon/database": ["packages/database/src/index.ts"],
      "@connectwon/database/*": ["packages/database/src/*"]
    }
  }
}
