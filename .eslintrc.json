{
  // 루트 고정
  "root": true,

  // 플러그인 설정
  "plugins": ["@nx", "@typescript-eslint", "import", "playwright"],
  "env": {
    "es2022": true,
    "node": true,
    "browser": true
  },

  // 기본 확장 설정 (Next.js 및 호환성 문제 해결)
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:import/typescript",
    "plugin:playwright/playwright-test",
    "next/core-web-vitals"
  ],

  // TypeScript 파서
  "parser": "@typescript-eslint/parser",

  "parserOptions": {
    // 모노레포: 각 앱/패키지 tsconfig를 한 번에 인식
    "project": ["./tsconfig.json", "./apps/*/tsconfig.json", "./packages/*/tsconfig.json"],
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },

  // import 경로 해석 설정
  "settings": {
    "import/resolver": {
      // TS 경로 별칭/프로젝트 해석
      "typescript": {
        "project": ["./tsconfig.json", "./apps/*/tsconfig.json", "./packages/*/tsconfig.json"],
        "alwaysTryTypes": true
      },
      // ESM/Node 해석도 병행(.mjs/.js/.ts)
      "node": {
        "extensions": [".mjs", ".js", ".ts", ".tsx", ".jsx", ".cjs"]
      }
    },
    "react": {
      "version": "detect"
    }
  },

  // 산출물/캐시 무시
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "build/",
    ".next/",
    ".nx/",
    "coverage/",
    "generated/"
  ],

  "rules": {
    "@nx/enforce-module-boundaries": [
      "error",
      {
        "enforceBuildableLibDependency": true,
        "allow": [],
        "depConstraints": [
          { "sourceTag": "type:app", "onlyDependOnLibsWithTags": ["type:lib", "scope:shared"] },
          { "sourceTag": "scope:api", "onlyDependOnLibsWithTags": ["scope:shared"] }
        ]
      }
    ],

    // 팀 스타일
    "semi": ["error", "always"],
    "quotes": "off",
    "@typescript-eslint/quotes": "off",
    "indent": "off",
    "@typescript-eslint/indent": "off",
    "linebreak-style": "off",
    "no-trailing-spaces": "off",
    "no-console": "off",
    "object-shorthand": "off",
    "class-methods-use-this": "off",
    "no-underscore-dangle": "off",
    "no-plusplus": "off",
    "function-paren-newline": "off",
    "function-call-argument-newline": "off",
    "lines-between-class-members": "off",
    "@typescript-eslint/lines-between-class-members": "off",
    "@typescript-eslint/no-explicit-any": "off",
    "no-await-in-loop": "off",

    // 의존성 안전: 테스트/툴링에선 devDeps 허용
    "import/no-extraneous-dependencies": [
      "error",
      {
        "peerDependencies": true,
        "optionalDependencies": true,
        "devDependencies": false
      }
    ],

    // 가독성/중복 임포트 방지
    "import/order": [
      "warn",
      {
        "groups": [
          "builtin",
          "external",
          "internal",
          "parent",
          "sibling",
          "index",
          "object",
          "type"
        ],
        "pathGroups": [{ "pattern": "@connectwon/**", "group": "internal", "position": "after" }],
        "pathGroupsExcludedImportTypes": ["builtin"],
        "newlines-between": "always",
        "alphabetize": { "order": "asc", "caseInsensitive": true }
      }
    ],
    "import/no-duplicates": "warn",
    "import/newline-after-import": ["warn", { "count": 1 }],

    // 줄 길이 완화
    "max-len": [
      "warn",
      {
        "code": 120,
        "ignoreComments": true,
        "ignoreTrailingComments": true,
        "ignoreTemplateLiterals": true,
        "ignoreUrls": true
      }
    ],

    // Playwright
    "playwright/no-focused-test": "error",
    "playwright/no-skipped-test": "warn",
    "playwright/no-conditional-in-test": "warn",

    // Next.js 및 React 관련 추가 규칙
    "react/react-in-jsx-scope": "off",
    "react/prop-types": "off",
    "@next/next/no-html-link-for-pages": "off"
  },

  // 테스트/스토리/툴링 파일: devDependencies 허용 오버라이드
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/*.test.tsx",
        "**/*.spec.tsx",
        "**/*.stories.*",
        "**/*.mdx",
        "**/playwright.config.*",
        "**/vitest.config.*",
        "**/*.config.*",
        "scripts/**",
        "**/*.ts",
        "**/*.tsx",
        "**/*.js",
        "**/*.jsx"
      ],
      "rules": {
        "import/no-extraneous-dependencies": [
          "error",
          {
            "devDependencies": true,
            "peerDependencies": true,
            "optionalDependencies": true
          }
        ]
      }
    },

    // JS/Config 파일에서는 TS 전용 룰 일부 비활성화
    {
      "files": ["**/*.js", "**/*.cjs", "**/*.mjs"],
      "rules": {
        "@typescript-eslint/no-var-requires": "off"
      }
    },

    // Next.js 페이지/앱 라우터 파일들 특별 처리
    {
      "files": [
        "apps/*/src/app/**/*.tsx",
        "apps/*/src/pages/**/*.tsx",
        "apps/*/pages/**/*.tsx",
        "**/page.tsx",
        "**/layout.tsx",
        "**/loading.tsx",
        "**/error.tsx",
        "**/not-found.tsx"
      ],
      "rules": {
        "import/no-default-export": "off",
        "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]
      }
    }
  ],

  // eslint-disable 주석 남발 방지(유용)
  "reportUnusedDisableDirectives": true
}
