/**
 * Description : .dockerignore - 📌 도커 빌드 시 제외할 파일 및 디렉토리
 * Author : Shiwoo Min
 * Date : 2025-09-06
 * 09-06 - Docker 자체 설정 파일 제외 제거
 * 09-17 - root로 이동
 * 09-18 - reflect-metadata, @anthropic-ai/sdk 오류 해결을 위한 추가 제외사항
 */

// Node.js 관련
node_modules
**/node_modules
**/**/node_modules
***/***/node_modules

// 빌드 결과물
dist
**/dist
build
**/build
.next
**/.next
out
**/out

// 패키지 매니저 캐시
.pnpm
**/.pnpm
.pnpm-store
**/.pnpm-store
.cache
**/.cache
.yarn
**/.yarn

// 로그 및 임시 파일
*.log
**/*.log
*.tmp
*.temp
.DS_Store
**/.DS_Store

// 환경 및 설정 파일
.env*
.vscode
.idea

// Git 관련
.git

// 테스트 관련
coverage
**/coverage
test-results
**/test-results
.nyc_output
**/.nyc_output

// 허용할 파일/디렉토리만 명시
!packages/*/src
!packages/*/package.json
!packages/*/tsconfig.json
!packages/*/*.ts
!packages/*/*.d.ts
!apps/*/src
!apps/*/public
!apps/*/package.json
!apps/*/next.config.*
!apps/*/tailwind.config.*
!apps/*/postcss.config.*
!apps/*/tsconfig.json
!infra
!pnpm-lock.yaml
!package.json
!pnpm-workspace.yaml
!nx.json
!tsconfig*.json

// TypeScript incremental build 정보 제외
*.tsbuildinfo
**/*.tsbuildinfo

// Nx 혹은 turbo repo 캐시 디렉토리 제외
.turbo
**/.turbo

// 편집기 임시 및 백업 파일 제외
*.swp
*.swo
**/*.swp
**/*.swo

// 윈도우 썸네일 캐시 파일 제외
Thumbs.db
