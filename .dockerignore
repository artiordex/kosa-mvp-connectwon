/**
 * Description : .dockerignore - 📌 도커 빌드 시 제외할 파일 및 디렉토리
 * Author : Shiwoo Min
 * Date : 2025-09-06
 * 09-06 - Docker 자체 설정 파일 제외 제거
 * 09-17 - root로 이동
 * 09-18 - reflect-metadata, @anthropic-ai/sdk 오류 해결을 위한 추가 제외사항
 * 09-23 - Node.js/monorepo 구조 반영 및 ignore 단순화
 */

# Node.js 관련
node_modules

# 빌드 결과물
dist
build
.next
out

# 패키지 매니저 캐시
.pnpm
.pnpm-store
.cache
.yarn
.npm

# 로그 및 임시 파일
*.log
*.tmp
*.temp

# 환경 및 설정 파일
.env*
.vscode
.idea

# Git 관련
.git
.gitignore

# 테스트 관련
coverage
test-results
.nyc_output
playwright-report
cypress

# 허용할 파일/디렉토리만 명시
!packages/*/src
!packages/*/package.json
!packages/*/tsconfig.json
!packages/*/*.ts
!packages/*/*.d.ts
!packages/*/prisma/**
!apps/*/src
!apps/*/public
!apps/*/package.json
!apps/*/next.config.*
!apps/*/tailwind.config.*
!apps/*/postcss.config.*
!apps/*/tsconfig.json
!infra
!pnpm-lock.yaml
!package.json
!pnpm-workspace.yaml
!nx.json
!tsconfig*.json

# TypeScript incremental build 정보 제외
*.tsbuildinfo

# Nx / Turborepo 캐시 디렉토리
.turbo
.nx

# 편집기 임시 및 백업 파일
*.swp
*.swo

# OS 파일
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# 문서 및 라이선스
README.md
*.md
LICENSE

# Docker 관련
docker-compose.override.yml
docker-compose.*.yml
