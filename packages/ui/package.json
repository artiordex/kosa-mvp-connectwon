{
  "name": "@connectwon/ui",
  "version": "1.0.0",
  "description": "ConnectWon UI 컴포넌트 라이브러리",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui-types": {
      "types": "./dist/src/ui-types.d.ts",
      "import": "./dist/src/ui-types.js"
    },
    "./styles/*": {
      "types": "./dist/styles/*.d.ts",
      "import": "./dist/styles/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.7",
    "@fontsource/poppins": "^5.2.6",
    "@heroicons/react": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.10",
    "lucide-react": "^0.544.0",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^2.6.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "recharts": "^3.0.0",
    "next": "^15.0.0"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "18.3.7",
    "@types/react-dom": "^18.3.0",
    "@types/recharts": "^2.0.1",
    "tailwindcss": "^3.4.13"
  },
  "engines": {
    "node": ">=20.11"
  }
}
