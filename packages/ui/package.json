{
  "name": "@connectwon/ui",
  "version": "1.0.0",
  "description": "ConnectWon UI 컴포넌트 라이브러리 (React / Tailwind 기반)",
  "private": true,
  "type": "module",
  "sideEffects": ["./dist/**/*.css"],

  "files": ["dist"],

  "__comment_exports": "ESM/TS 타입 정의",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui-types": {
      "types": "./dist/ui-types.d.ts",
      "import": "./dist/ui-types.js"
    },
    "./tailwind-config": {
      "import": "./dist/tailwind.config.mjs"
    },
    "./styles/*": "./dist/styles/*",
    "./package.json": "./package.json"
  },

  "__comment_scripts": "빌드 및 타입체크 스크립트",
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "postbuild": "shx mkdir -p ./dist && shx cp ./tailwind.config.mjs ./dist/ && shx cp -r ./public ./dist/ && shx cp -r ./src/styles ./dist/styles",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },

  "__comment_dependencies": "UI 패키지가 직접 사용하는 런타임 의존성",
  "dependencies": {
    "@connectwon/configs": "workspace:*",
    "@fontsource/inter": "^5.2.7",
    "@fontsource/poppins": "^5.2.6",
    "@heroicons/react": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.10",
    "lucide-react": "^0.544.0",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^2.6.0"
  },

  "__comment_peerDependencies": "호스트 앱(Next.js 등)이 제공해야 하는 의존성",
  "peerDependencies": {
    "next": "15.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    }
  },

  "__comment_devDependencies": "개발/빌드 도구 및 Tailwind 플러그인",
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.3.1",
    "@types/react": "^18.3.7",
    "@types/react-dom": "^18.3.0",
    "@types/recharts": "^2.0.1",
    "eslint": "^9.36.0",
    "rimraf": "^6.0.1",
    "shx": "^0.3.4",
    "typescript": "5.6.3"
  },

  "__comment_nx": "Nx 그래프 자동 종속 제거 설정",
  "nx": {
    "implicitDependencies": [],
    "targets": {
      "build": {
        "dependsOn": []
      }
    }
  },

  "__comment_engines": "Node 20+ 런타임 보장",
  "engines": {
    "node": ">=20.11"
  }
}
