{
  "name": "@connectwon/ui",
  "version": "1.0.0",
  "description": "ConnectWon UI 컨포넌트 라이브러리",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles/*": "./styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm -w exec tsc -p tsconfig.json",
    "dev": "pnpm -w exec tsc -w -p tsconfig.json",
    "clean": "pnpm -w exec rimraf dist",
    "prepublishOnly": "pnpm run build",
    "type-check": "pnpm -w exec tsc --noEmit -p tsconfig.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@fontsource/inter": "^5.2.7",
    "@fontsource/poppins": "^5.2.6",
    "@heroicons/react": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "lucide-react": "^0.544.0",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^2.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "recharts": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/recharts": "^2.0.1",
    "tailwindcss": "^3.4.13"
  },
  "engines": {
    "node": ">=20.11"
  }
}
