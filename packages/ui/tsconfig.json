/**
 * Description : ui/tsconfig.json - 📌 UI 패키지 (TypeScript 설정)
 * Author : Shiwoo Min
 * Date : 2025-09-12
 */
{
  // 루트의 tsconfig.base.json 상속
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // I/O 경로
    "rootDir": "./src",
    "outDir": "../../dist/packages/ui",
    "declarationDir": "../../dist/packages/ui",

    // 프로젝트 레퍼런스 대상
    "composite": true,

    // React 17+ JSX 트랜스폼
    "jsx": "react-jsx",

    // 번들러 친화 ESM 해석 (Next/webpack/vite 등 소비자 기준)
    "module": "esnext",
    "moduleResolution": "Bundler",

    // 브라우저 타깃
    "lib": ["es2022", "dom", "dom.iterable"],

    // Node 전역 타입 유입 방지 (웹 라이브러리는 비우는 게 안전)
    "types": [],

    // 타입 선언 및 소스맵
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // 모노레포 최적화
    "incremental": true,
    "tsBuildInfoFile": "../../dist/packages/ui/.tsbuildinfo"
  },

  // src 기준으로 포함
  "include": ["src/**/*"],

  // 제외할 파일/폴더
  "exclude": ["dist", "node_modules"],

  // 프로젝트 참조
  "references": [{ "path": "../core" }, { "path": "../configs" }, { "path": "../logger" }]
}
