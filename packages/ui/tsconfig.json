{
  // 루트의 tsconfig.json 상속
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "composite": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*", "src/**/index.ts", "ui-types.ts", "hook-types.ts", "component-types.ts"],
  "exclude": ["dist", "node_modules"],
  "references": []
}
