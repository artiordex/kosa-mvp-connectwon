/**
 * Description : tsconfig.json - 📌 UI 패키지
 * Author : Shiwoo Min
 * Date : 2025-10-09
 *
 * Environment :
 *  - Docker / Cloud Run / Firebase / Azure / Local 완전 호환
 *  - React + Tailwind + ESM 기반 UI 라이브러리
 *  - Nx tsc executor 및 번들러(rollup/vite/tsup) 병행 빌드 지원
 *
 * Note :
 *  - UI 컴포넌트, hooks, styles, icons, theme 설정 포함
 *  - 브라우저 중심(SSR 비의존)
 *  - 빌드 로그 확인: pnpm tsc -p tsconfig.json --listEmittedFiles
 */
{
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    // Incremental build & Nx 캐시 통합
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "../../dist/packages/ui/.tsbuildinfo",

    // 경로 설정
    "rootDir": "./src",
    "outDir": "../../dist/packages/ui",
    "declarationDir": "../../dist/packages/ui",

    // React JSX (자동 런타임)
    "jsx": "react-jsx",

    // 모듈 해석 (ESM 기반)
    "module": "esnext",
    "moduleResolution": "bundler",

    // 대상 환경 (브라우저 우선)
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],

    // 선언 및 디버깅 옵션
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // 품질 및 호환성
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    // Node 전역 타입은 불필요 (UI는 브라우저 전용)
    "types": [],

    // 경로 alias
    "baseUrl": "./",
    "paths": {
      "@connectwon/ui/*": ["src/*"]
    },

    // CI / Docker 환경 안전 모드
    "noEmitOnError": false
  },

  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.spec.ts"],

  // Nx 프로젝트 간 종속성 (빌드 순서)
  "references": [
    { "path": "../core" },
    { "path": "../configs" },
    { "path": "../logger" }
  ]
}
