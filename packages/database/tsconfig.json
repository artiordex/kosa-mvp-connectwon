 * 09-10 : core 패키지의 domain/authz 참조 추가
 */
{
  // 루트의 tsconfig.json 상속
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"],
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*",
    "prisma/seed.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/generated",
    "prisma/migrations"
  ],
  "references": [
  ]
}
