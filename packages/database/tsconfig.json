/**
 * Description : tsconfig.json - 📌 Database 패키지 (Prisma + PostgreSQL + Core 연동)
 * Author : Shiwoo Min
 * Date : 2025-10-09
 *
 * Environment :
 *  - Docker / Cloud Run / Firebase / Azure / Local 개발환경 완전 호환
 *  - ESM 기반 (NodeNext) + Prisma CLI / Client 완전 대응
 *
 * Note :
 *  - Prisma CLI는 NodeNext 또는 Bundler 기반 ESM만 정상 지원
 *  - Core/Logger 패키지 타입 자동 추적 (Nx project reference 기반)
 *  - 빌드 로그 : tsc -p tsconfig.json --listEmittedFiles
 */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,

    // 출력 경로
    "rootDir": "./src",
    "outDir": "../../dist/packages/database",
    "declarationDir": "../../dist/packages/database",
    "tsBuildInfoFile": "../../dist/packages/database/.tsbuildinfo",

    // NodeNext (ESM) 모듈 해석
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "verbatimModuleSyntax": true,

    // 선언 파일 / 소스맵 / 증분 빌드
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,

    // Node 환경 옵션
    "types": ["node"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    // 품질 / 안정성
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },

  "include": ["src/**/*", "prisma/**/*.ts", "prisma/seed.ts"],
  "exclude": ["dist", "node_modules", "src/generated", "prisma/migrations"],

  // Project References (core/logger)
  "references": [
    { "path": "../core" },
    { "path": "../logger" }
  ]
}
