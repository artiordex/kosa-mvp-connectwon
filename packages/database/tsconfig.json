/**
 * Description : tsconfig.json - 📌 database 패키지의 tsconfig.json
 * Author : Shiwoo Min
 * Date : 2025-09-05
 * Updated : 2025-09-07 (prisma 지원 추가)
 */

{
  // 루트의 tsconfig.json 상속
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    // rootDir 제거 - prisma 폴더 때문에 충돌 발생
    "types": ["node"],
    "composite": true,
    // ES 모듈 지원
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*",
    "prisma/seed.ts"
, "../core/domain/authz/index.ts"  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/generated",
    "prisma/migrations"
  ],
  "references": [
  ]
}
