{
  "name": "@connectwon/client",
  "version": "1.0.0",
  "description": "ConnectWon Next.js/React 클라이언트 유틸리티",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/packages/client/index.d.ts",
      "import": "./dist/packages/client/index.js"
    },
    "./client-types": {
      "types": "./dist/packages/client/client-types.d.ts",
      "import": "./dist/packages/client/client-types.js"
    },
    "./package.json": "./package.json"
  },
  "__comment_scripts": "빌드 및 퍼블리시 스크립트",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm run build"
  },
  "__comment_peerDependencies": "런타임 환경에서 반드시 필요한 peer",
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "next": "15.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "__comment_devDependencies": "개발 및 타입체크용 의존성",
  "devDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@types/react": "18.3.7",
    "@types/react-dom": "18.3.0",
    "eslint": "^9.36.0",
    "prettier": "^3.5.3",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "firebase": "^12.3.0"
  }
}
