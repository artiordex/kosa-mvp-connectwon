{
  "name": "@connectwon/client",
  "version": "1.0.0",
  "description": "ConnectWon 클라이언트 유틸리티",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],

  "__comment_entry": "ESM / CJS 완전 호환 엔트리 설정 (Next.js, Node, Browser 대응)",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*",
      "require": "./dist/*",
      "types": "./dist/*"
    },
    "./mocks": {
      "import": "./dist/mocks/index.js",
      "require": "./dist/mocks/index.js",
      "types": "./dist/mocks/index.d.ts"
    },
    "./mocks/*": {
      "import": "./dist/mocks/*.js",
      "require": "./dist/mocks/*.js",
      "types": "./dist/mocks/*.d.ts"
    },
    "./package.json": "./package.json"
  },

  "__comment_scripts": "빌드 및 배포 스크립트",
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },

  "__comment_peerDependencies": "React 환경에서 호스트 앱이 제공해야 하는 의존성",
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": { "optional": true }
  },

  "__comment_dependencies": "런타임 의존성 (Firebase SDK 등)",
  "dependencies": {
    "firebase": "^12.3.0"
  },

  "__comment_devDependencies": "개발 및 빌드 도구",
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@mswjs/data": "^0.16.2",
    "@types/react": "^18.3.7",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.36.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "tsup": "^8.0.1",
    "typescript": "^5.6.3"
  },

  "__comment_nx": "Nx 그래프 종속성 및 캐시 설정",
  "nx": {
    "implicitDependencies": [],
    "targets": {
      "build": {
        "dependsOn": ["^build"]
      }
    }
  },

  "__comment_engines": "Node 20+ 환경 보장",
  "engines": {
    "node": ">=20.11"
  }
}
