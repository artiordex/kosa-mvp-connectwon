/**
 * Description : tsconfig.json - 📌 Client 패키지 (React + Mock 구조 통합)
 * Author : Shiwoo Min
 * Date  : 2025-10-09
 */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,

    // 경로 설정
    "rootDir": "./src",
    "outDir": "../../dist/packages/client",
    "declarationDir": "../../dist/packages/client",
    "tsBuildInfoFile": "../../dist/packages/client/.tsbuildinfo",

    // ESM + 번들러 해석
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,

    // 선언 파일 / 소스맵 / 증분 빌드
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,

    // React JSX
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "es2022"],

    // 타입 및 품질 설정
    "types": ["node", "react", "react-dom"],
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "allowArbitraryExtensions": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmitOnError": false
  },

  "__comment_include": "모든 src 하위 (mocks 포함)",
  "include": ["src/**/*", "src/**/*.json"],

  "__comment_exclude": "빌드 및 node_modules 제외",
  "exclude": ["dist", "node_modules"],

  "__comment_references": "API contract 패키지 참조",
  "references": [
    { "path": "../api-contract" }
  ]
}
