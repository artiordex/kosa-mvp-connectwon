{
  "name": "@connectwon/api-contract",
  "version": "1.0.0",
  "description": "API 스키마/타입(zod, ts-rest) 및 OpenAPI 산출용 공용 패키지",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/packages/api-contract/index.d.ts",
      "import": "./dist/packages/api-contract/index.js"
    },
    "./api-contract-types": {
      "types": "./dist/packages/api-contract/api-contract-types.d.ts",
      "import": "./dist/packages/api-contract/api-contract-types.js"
    },
    "./package.json": "./package.json"
  },
  "__comment_scripts": "빌드 및 타입 체크 관련 스크립트",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch -p tsconfig.json",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "__comment_dependencies": "런타임 의존성",
  "dependencies": {
    "@ts-rest/core": "^3.52.1",
    "swagger-ui-dist": "^5.29.0",
    "zod": "^3.23.8"
  },
  "__comment_devDependencies": "개발 의존성",
  "devDependencies": {
    "@types/node": "^24.3.1",
    "openapi-types": "^12.1.3"
  }
}
