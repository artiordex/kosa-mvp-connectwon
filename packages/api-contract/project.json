{
  "name": "@connectwon/api-contract",
  "sourceRoot": "packages/api-contract/src",

  "__comment_projectType": "Nx 프로젝트 타입",
  "projectType": "library",
  "version": "1.0.0",
  "tags": ["type:lib", "layer:shared"],

  "__comment_targets": "빌드/린트/테스트/문서 생성",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "main": "packages/api-contract/src/index.ts",
        "outputPath": "dist/packages/api-contract",
        "tsConfig": "packages/api-contract/tsconfig.json",
        "assets": [
          "packages/api-contract/package.json"
        ]
      }
    },
    "gen:openapi": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "tsx packages/api-contract/src/openapi/emit.ts"
          }
        ],
        "parallel": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["packages/api-contract/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "options": {
        "passWithNoTests": true
      }
    }
  }
}
