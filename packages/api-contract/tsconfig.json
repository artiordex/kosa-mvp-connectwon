/**
 * Description : tsconfig.json - 📌 API 계약 패키지 (TypeScript 설정)
 * Author : Shiwoo Min
 * Date  : 2025-10-09
 *
 * Environment :
 *  - Docker / Cloud Run / Firebase / Azure / Local 개발환경 완전 호환
 *  - ESM 기반 (NodeNext) + 번들러 호환 (Nx tsc executor)
 *
 * Note :
 *  - outDir / declarationDir 통합
 *  - incremental 빌드 지원
 *  - Node 타입 포함 (emit.ts 등 Node 실행용)
 */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,

    // 입출력 디렉토리
    "rootDir": "./src",
    "outDir": "../../dist/packages/api-contract",
    "declarationDir": "../../dist/packages/api-contract",
    "tsBuildInfoFile": "../../dist/packages/api-contract/.tsbuildinfo",

    // 모듈 설정 (ESM + 번들러 호환)
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,

    // 선언 파일, 소스맵, 증분 빌드
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,

    // 라이브러리 및 타입
    "lib": ["es2022"],
    "types": ["node"],

    // JS 허용
    "allowJs": true,
    "checkJs": true,

    // 품질/편의 설정
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "stripInternal": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },

  // 포함/제외 경로
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"],

  // 상위 core 패키지 참조
  "references": [
    { "path": "../core" }
  ]
}
