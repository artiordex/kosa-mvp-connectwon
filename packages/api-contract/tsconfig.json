/**
  * Description : tsconfig.json - 📌 api-contract 의 tsconfig.json 최소유지
  * Author : Shiwoo Min
  * Date : 2025-09-05
  */

{
  // 루트의 tsconfig.json 상속
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,
    "stripInternal": true
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
