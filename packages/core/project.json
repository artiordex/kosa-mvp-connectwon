{
  "name": "@connectwon/core",
  "sourceRoot": "packages/core/src",
  "projectType": "library",
  "tags": ["type:lib", "layer:backend", "layer:tooling"],

  "__comment_targets": "Nx 빌드/린트/테스트 설정",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "main": "packages/core/src/index.ts",
        "outputPath": "dist/packages/core",
        "tsConfig": "packages/core/tsconfig.json",
        "assets": [
          "packages/core/package.json",
          "packages/core/src/configs/**/*"
        ],
        "generatePackageJson": false
      },
      "outputs": ["{options.outputPath}"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["packages/core/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "options": {
        "passWithNoTests": true
      }
    }
  },

  "__comment_dependencies": "api-contract과의 의존 관계 명시",
  "implicitDependencies": ["@connectwon/api-contract"]
}
