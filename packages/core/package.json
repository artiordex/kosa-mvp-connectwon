{
  "name": "@connectwon/core",
  "version": "1.0.0",
  "description": "ConnectWon 핵심 라이브러리",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core-types": {
      "types": "./dist/core-types.d.ts",
      "import": "./dist/core-types.js"
    },
    "./queue": {
      "types": "./dist/queue/index.d.ts",
      "import": "./dist/queue/index.js"
    },
    "./application/*": {
      "types": "./dist/application/*.d.ts",
      "import": "./dist/application/*.js"
    },
    "./infrastructure/*": {
      "types": "./dist/infrastructure/*.d.ts",
      "import": "./dist/infrastructure/*.js"
    },
    "./ports/*": {
      "types": "./dist/ports/*.d.ts",
      "import": "./dist/ports/*.js"
    },
    "./adapters/*": {
      "types": "./dist/adapters/*.d.ts",
      "import": "./dist/adapters/*.js"
    },
    "./domain/*": {
      "types": "./dist/domain/*.d.ts",
      "import": "./dist/domain/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "__comment_scripts": "pnpm scripts 명령어",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.61.0",
    "@huggingface/inference": "^4.7.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.58.5",
    "dayjs": "^1.11.10",
    "ioredis": "^5.7.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.6",
    "openai": "^5.20.0",
    "openapi-types": "^12.1.3",
    "openapi3-ts": "^4.5.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@nestjs/common": "^11",
    "@nestjs/core": "^11"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@connectwon/configs": "workspace:*",
    "@types/nodemailer": "^7.0.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "rimraf": "^6.0.1"
  }
}
