{
  // 루트의 tsconfig.json 상속
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ],
  "references": [
    { "path": "../types" },
    { "path": "../logger" },
    { "path": "../database" },
    { "path": "../api-contract" }
  ]
}
