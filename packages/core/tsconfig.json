/**
 * Description : tsconfig.json - 📌 Core 패키지 (TypeScript 설정)
 * Author : Shiwoo Min
 * Date : 2025-09-10
 * 09-10 : core 패키지의 domain/authz 참조 추가
 * 09-12 : 선언파일/소스맵/증분빌드/레퍼런스 정리
 * 09-22 : .d.ts 파일 사용으로 변경, declaration 중복 생성 방지
 * 09-26 : alias(@connectwon/core-types) 추가
 * 빌드 로그 확인 - tsc -p tsconfig.json --listEmittedFiles
 */
{
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    // 출력/입력 경로
    "outDir": "./dist",
    "rootDir": ".",

    // 서버 전용 타깃 (브라우저 타입 유입 방지)
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],

    // Node ESM 해석
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // 선언 파일 및 디버깅
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "emitDeclarationOnly": false,

    // 모노레포 증분 빌드
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",

    // 상호운용/편의
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "exactOptionalPropertyTypes": true,

    // 💡 core 내부 alias
    "baseUrl": ".",
    "paths": {
      "@connectwon/core/*": ["src/*"],
      "@connectwon/core-types": ["core-types.ts"]
    }
  },

  "include": ["core-types.ts", "core-types.d.ts", "src/**/*"],
  "exclude": ["dist", "node_modules", "**/*.test.*", "**/*.spec.*"],

  // 순환 참조 방지: database → core 참조만 허용, core → database 금지
  "references": [{ "path": "../api-contract" }]
}
