{
  // 루트의 tsconfig.json 상속
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "composite": true,
    "lib": ["ES2022"]
  },
  "include": ["src/**/*.ts", "src/**/**/*.ts", "core-types.ts"],
  "exclude": ["dist", "node_modules"],
  "references": [{ "path": "../logger" }, { "path": "../database" }, { "path": "../api-contract" }]
}
