/**
 * Description : tsconfig.json - 📌 Core 패키지
 * Author : Shiwoo Min
 * Date : 2025-10-09
 *
 * Environment :
 *  - Docker / Cloud Run / Firebase / Azure / Local 개발환경 완전 호환
 *  - ESM 기반 (NodeNext) + 번들러 호환 (Nx tsc executor)
 *
 * Note :
 *  - core domain/authz/queue 등 핵심 서비스 로직
 *  - AI SDK 및 Redis/BullMQ 호환성 보장
 *  - 빌드 로그 : tsc -p tsconfig.json --listEmittedFiles
 */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,

    // 경로 설정
    "rootDir": "./src",
    "outDir": "../../dist/packages/core",
    "declarationDir": "../../dist/packages/core",
    "tsBuildInfoFile": "../../dist/packages/core/.tsbuildinfo",

    // NodeNext / ESM 모듈 해석
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022"],
    "verbatimModuleSyntax": true,

    // 선언 파일 및 디버깅
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,

    // Node 환경
    "types": ["node"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    // 품질 / 안정성
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "exactOptionalPropertyTypes": true,

    // 내부 경로 alias
    "baseUrl": "./",
    "paths": {
      "@connectwon/core/*": ["src/*"],
      "@connectwon/core-types": ["src/core-types.ts"]
    }
  },

  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "**/*.test.*", "**/*.spec.*"],

  // Project References
  "references": [
    { "path": "../api-contract" }
  ]
}
