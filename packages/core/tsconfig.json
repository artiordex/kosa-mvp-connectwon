/**
 * Description : tsconfig.json - 📌 Core 패키지
 * Author : Shiwoo Min
 * Date : 2025-09-28
 * 09-10 : core 패키지의 domain/authz 참조 추가
 * 09-12 : 선언파일/소스맵/증분빌드/레퍼런스 정리
 * 09-22 : .d.ts 파일 사용으로 변경, declaration 중복 생성 방지
 * 09-26 : alias(@connectwon/core-types) 추가
 * 09-28 : configs(ts/json) 통합 반영 (resolveJsonModule, include 패턴 확장)
 * 빌드 로그 확인 - tsc -p tsconfig.json --listEmittedFiles
 */
{
  // 루트의 tsconfig.base.json 상속
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // I/O 경로
    "rootDir": "./src",
    "outDir": "../../dist/packages/core",
    "declarationDir": "../../dist/packages/core",

    // Node ESM 해석 (config TS 파일 import 시 일관성↑)
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node", "eslint"],

    // 선언 파일 및 디버깅
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "emitDeclarationOnly": false,

    // 모노레포 증분 빌드
    "incremental": true,
    "tsBuildInfoFile": "../../dist/packages/core/.tsbuildinfo",

    // 상호운용/편의
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "exactOptionalPropertyTypes": true
  },

  // 포함 범위
  "include": ["src/**/*"],

  // 불필요한 폴더 제외
  "exclude": ["dist", "node_modules", "**/*.test.*", "**/*.spec.*"],

  // 순환 참조 방지: database → core 참조만 허용, core → database 금지
  "references": []
}
