{
  "name": "@connectwon/server",
  "sourceRoot": "packages/server/src",
  "projectType": "library",
  "tags": ["type:lib", "layer:backend"],

  "__comment_targets": "Nx 빌드/린트/테스트 설정",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "main": "packages/server/src/index.ts",
        "outputPath": "dist/packages/server",
        "tsConfig": "packages/server/tsconfig.json",
        "assets": ["packages/server/package.json"]
      },
      "outputs": ["{options.outputPath}"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["packages/server/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "options": {
        "passWithNoTests": true
      }
    }
  },

  "__comment_dependencies": "logger/core/database 종속성 자동 관리",
  "implicitDependencies": [
    "@connectwon/logger",
    "@connectwon/core",
    "@connectwon/database"
  ]
}
