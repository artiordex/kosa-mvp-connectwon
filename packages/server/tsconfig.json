/**
 * Description : tsconfig.json - 📌 Server 패키지 (NestJS 공용 유틸/모듈)
 * Author : Shiwoo Min
 * Date : 2025-10-09
 *
 * Environment :
 *  - Docker / Cloud Run / Firebase / Azure / Local 개발환경 완전 호환
 *  - ESM 기반 (NodeNext) + 번들러 호환 (Nx tsc executor)
 *
 * Note :
 *  - NestJS용 공용 필터, 인터셉터, 데코레이터, 모듈 유틸 제공
 *  - Core/Logger/Database 의존
 *  - 빌드 로그 : tsc -p tsconfig.json --listEmittedFiles
 */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,

    // 출력 경로
    "rootDir": "./src",
    "outDir": "../../dist/packages/server",
    "declarationDir": "../../dist/packages/server",
    "tsBuildInfoFile": "../../dist/packages/server/.tsbuildinfo",

    // NodeNext / Bundler 해석
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022"],
    "verbatimModuleSyntax": true,

    // 선언 및 디버깅
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,

    // Node 환경
    "types": ["node"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    // 품질 / 안정성
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,

    // 경로 alias
    "baseUrl": "./",
    "paths": {
      "@connectwon/server/*": ["src/*"]
    }
  },

  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"],

  // Project References
  "references": [
    { "path": "../core" },
    { "path": "../logger" },
    { "path": "../database" }
  ]
}
