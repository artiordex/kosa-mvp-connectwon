/**
 * Description : tsconfig.json - 📌 Nest.js 패키지 (TypeScript 설정 + core 참조)
 * Author : Shiwoo Min
 * Date : 2025-09-12
 */
{
  // 루트의 tsconfig.base.json 상속
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // 입출력 경로
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",

    // NestJS 추천 옵션
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,

    // ESM/CJS 상호운용
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "types": ["node"],

    // core alias 연결
    "baseUrl": ".",
    "paths": {
      // core 모듈 경로
      "@connectwon/core/*": ["../core/src/*"],
      "@connectwon/core": ["../core/src"],
      "@connectwon/core-types": ["../core/core-types.ts"]
    }
  },
  // server 소스만 포함
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.*", "**/*.spec.*"],

  // 모노레포 빌드 순서 보장
  "references": [{ "path": "../core" }]
}
