/**
 * Description : tsconfig.json - 📌 Nest.js 패키지 (TypeScript 설정 + core 참조)
 * Author : Shiwoo Min
 * Date : 2025-09-12
 */
{
  // 루트의 tsconfig.base.json 상속
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    // 출력 설정
    "rootDir": "./src",
    "outDir": "../../dist/packages/server",
    "tsBuildInfoFile": "../../dist/packages/server/.tsbuildinfo",

    // Project References 필수
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,

    // NestJS 권장 옵션
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,

    // ESM/CJS 상호운용
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    // 기타 유틸 옵션
    "resolveJsonModule": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "types": ["node"]
  },

  // server 소스만 포함
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.*", "**/*.spec.*"],

  // 모노레포 빌드 순서 보장
  "references": [{ "path": "../core" }]
}
