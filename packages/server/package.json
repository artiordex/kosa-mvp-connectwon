{
  "name": "@connectwon/server",
  "version": "1.0.0",
  "description": "ConnectWon NestJS 공통 모듈 및 유틸리티",
  "private": true,
  "type": "module",
  "sideEffects": false,
    "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/packages/server/index.d.ts",
      "import": "./dist/packages/server/index.js"
    },
    "./server-types": {
      "types": "./dist/packages/server/server-types.d.ts",
      "import": "./dist/packages/server/server-types.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.61.0",
    "@sentry/nestjs": "^10.14.0",
    "@slack/web-api": "^7.6.0",
    "bcrypt": "^6.0.0",
    "express": "^4.21.2",
    "google-auth-library": "^10.3.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.6",
    "openai": "^5.20.0",
    "redis": "^5.8.2",
    "rxjs": "^7.8.2",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/swagger": "^11.2.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "@nestjs/swagger": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/nodemailer": "^7.0.1",
    "@types/swagger-ui-express": "^4.1.8"
  },
  "engines": {
    "node": ">=20.11"
  }
}
