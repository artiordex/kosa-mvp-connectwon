{
  "name": "@connectwon/server",
  "version": "1.0.0",
  "description": "ConnectWon NestJS 공통 모듈 및 유틸리티",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
