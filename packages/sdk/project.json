{
  "name": "@connectwon/sdk",
  "sourceRoot": "packages/sdk/src",
  "projectType": "library",
  "tags": ["type:lib", "layer:shared"],

  "__comment_targets": "Nx 빌드/린트/테스트 설정",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "main": "packages/sdk/src/index.ts",
        "outputPath": "dist/packages/sdk",
        "tsConfig": "packages/sdk/tsconfig.json",
        "assets": ["packages/sdk/package.json"]
      },
      "outputs": ["{options.outputPath}"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["packages/sdk/**/*.{ts,tsx}"]
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "options": {
        "passWithNoTests": true
      }
    }
  },

  "__comment_dependencies": "api-contract, core, logger 의존성",
  "implicitDependencies": [
    "@connectwon/api-contract",
    "@connectwon/core",
    "@connectwon/logger"
  ]
}
