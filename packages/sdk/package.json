{
  "name": "@connectwon/sdk",
  "version": "1.0.0",
  "description": "ConnectWon SDK - 웹 스크래핑, AI 연동 및 클라이언트 유틸리티 모듈",
  "private": true,
  "type": "module",
  "sideEffects": false,

  "files": ["dist"],

  "__comment_exports": "ESM/TS 타입 정의",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },

  "__comment_scripts": "빌드/개발/배포 스크립트",
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },

  "__comment_dependencies": "실행 시 필요한 런타임 의존성 (API/Logger/Core 참조)",
  "dependencies": {
    "@connectwon/api-contract": "workspace:*",
    "@connectwon/core": "workspace:*",
    "@connectwon/logger": "workspace:*"
  },

  "__comment_devDependencies": "개발/테스트/빌드용 의존성",
  "devDependencies": {
    "@types/node": "^24.3.1",
    "typescript": "5.6.3",
    "eslint": "^9.36.0",
    "rimraf": "^6.0.1",
    "vitest": "^3.2.4"
  },

  "__comment_engines": "런타임 요구사항",
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=10.7.0"
  },

  "__comment_nx": "Nx 그래프 자동 종속 관리",
  "nx": {
    "implicitDependencies": [
      "@connectwon/api-contract",
      "@connectwon/core",
      "@connectwon/logger"
    ],
    "targets": {
      "build": {
        "dependsOn": ["^build"]
      }
    }
  }
}
