{
  "name": "@connectwon/sdk",
  "version": "1.0.0",
  "description": "ConnectWon SDK - 웹 스크래핑 및 AI 연동 클라이언트/유틸리티",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/packages/sdk/index.d.ts",
      "import": "./dist/packages/sdk/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "__comment_scripts": "빌드/개발/배포 스크립트",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch -p tsconfig.json",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "__comment_dependencies": "실행 시 필요한 런타임 의존성",
  "dependencies": {
    "@connectwon/api-contract": "workspace:*"
  },
  "__comment_devDependencies": "개발용/빌드 도구",
  "devDependencies": {
    "@types/node": "^24.3.1",
    "typescript": "5.6.3",
    "eslint": "^9.36.0",
    "rimraf": "^6.0.1",
    "vitest": "^3.2.4"
  },
  "__comment_engines": "런타임 요구사항",
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=10.7.0"
  }
}
