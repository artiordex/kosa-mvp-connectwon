{
  "name": "@connectwon/sdk",
  "version": "1.0.0",
  "description": "ConnectWon SDK - 웹 스크래핑 및 AI 연동 클라이언트/유틸리티",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/packages/sdk/index.d.ts",
      "import": "./dist/packages/sdk/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch -p tsconfig.json",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "dependencies": {
    "@connectwon/api-contract": "workspace:*"
  },
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=9.0.0"
  }
}
