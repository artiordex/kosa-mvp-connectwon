/**
 * Description : tsconfig.json - 📌 SDK 패키지
 * Author : Shiwoo Min
 * Date : 2025-10-09
 *
 * Environment :
 *  - Docker / Cloud Run / Firebase / Azure / Local 개발환경 완전 호환
 *  - ESM 기반 (NodeNext) + 번들러 호환 (Nx tsc executor)
 *
 * Note :
 *  - SDK는 브라우저와 Node 환경 모두를 대상으로 동작
 *  - AI 호출, Web Scraping, Web Worker, API Request 유틸리티 포함
 *  - 빌드 로그 : tsc -p tsconfig.json --listEmittedFiles
 */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,

    // 출력 경로
    "rootDir": "./src",
    "outDir": "../../dist/packages/sdk",
    "declarationDir": "../../dist/packages/sdk",
    "tsBuildInfoFile": "../../dist/packages/sdk/.tsbuildinfo",

    // NodeNext / ESM / Bundler 호환
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "verbatimModuleSyntax": true,

    // 선언 및 디버깅
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,

    // Node 및 브라우저 환경
    "types": ["node"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    // 품질 / 일관성
    "skipLibCheck": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,

    // 내부 경로 alias
    "baseUrl": "./",
    "paths": {
      "@connectwon/sdk/*": ["src/*"]
    }
  },

  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"],

  // Project References
  "references": [
    { "path": "../api-contract" },
    { "path": "../core" },
    { "path": "../logger" }
  ]
}
