/**
 * Description : tsconfig.json - 📌 SDK 패키지 (TypeScript 설정)
 * Author : Shiwoo Min
 * Date : 2025-09-12
 */
{
  // 루트의 tsconfig.base.json 상속
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    // 출력 설정
    "rootDir": "typescript/src",
    "outDir": "../../dist/packages/sdk",

    // Node ESM 권장
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    // d.ts 생성 (루트 base에도 있지만 명시 유지)
    "declaration": true,

    // 엄격 모드 및 성능
    "strict": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,

    // 브라우저 타깃 (Iterable API 사용 시 DOM.Iterable 포함)
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    // 프로젝트 레퍼런스 활성화
    "composite": true,

    // Node 전역 타입 유입 방지 (isomorphic 충돌 예방)
    "types": ["node"]
  },

  // 루트에 배치한 타입 파일 포함
  "include": ["typescript/src/**/*", "typescript/src/sdk-types.ts"],
  "exclude": ["dist", "node_modules", "../../tools/**/*", "../../tests/**/*", "**/*.test.*"],

  // 의존 패키지 참조
  "references": [{ "path": "../api-contract" }, { "path": "../logger" }]
}
