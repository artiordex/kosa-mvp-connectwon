/**
 * Description : tsconfig.json - 📌 SDK 패키지 (TypeScript 설정)
 * Author : Shiwoo Min
 * Date : 2025-09-12
 * 09-30 : src 디렉토리 구조 단순화 (typescript/src → src)
 */
{
  // 루트의 tsconfig.base.json 상속
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // I/O 경로
    "rootDir": "./src",
    "outDir": "../../dist/packages/sdk",
    "declarationDir": "../../dist/packages/sdk/types",

    // Node ESM 권장
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    // d.ts 생성 (루트 base에도 있지만 명시 유지)
    "declaration": true,

    // 엄격 모드 및 성능
    "strict": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,

    // 브라우저 타깃 (Iterable API 사용 시 DOM.Iterable 포함)
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    // 프로젝트 레퍼런스 활성화
    "composite": true,

    // Node 전역 타입 유입 방지
    "types": ["node"]
  },

  // 포함 범위
  "include": ["src/**/*"],

  // 불필요한 폴더 및 파일 제외
  "exclude": [
    "dist",
    "node_modules"
  ],

  // 의존 패키지 참조 (api-contract, logger 사용)
  "references": [
    { "path": "../api-contract" },
    { "path": "../logger" }
  ]
}
