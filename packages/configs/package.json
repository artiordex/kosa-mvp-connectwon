{
  "name": "@connectwon/configs",
  "version": "1.0.0",
  "description": "ConnectWon 공통 설정 Config",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
    "types": "./dist/packages/configs/index.d.ts",
    "import": "./dist/packages/configs/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "eslint": ">=8.57",
    "tailwindcss": ">=3.4",
    "typescript": ">=5.4",
    "vite-tsconfig-paths": ">=4.3",
    "vitest": ">=1.5"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
