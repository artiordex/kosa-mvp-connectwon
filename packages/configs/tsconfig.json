/**
 * Description : tsconfig.json - 📌 Config 패키지 (TypeScript 설정)
 * Author : Shiwoo Min
 * Date : 2025-09-05
 * 09-09 : noEmit=true, include 범위 축소, JS 제외(TS 전용)
 * 09-12 : NodeNext 해석/JSON 모듈/Node 타입 추가
 * 09-30 : Project References 대응 → composite: true / noEmit 제거
 * 명령어 : ls -l dist/packages/configs/index.*
 */
{
  // 루트의 tsconfig.base.json 상속
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,

    // 출력 경로 (dist로 내보내도록 수정)
    "rootDir": "./src",
    "outDir": "../../dist/packages/configs",
    "declarationDir": "../../dist/packages/configs",

    // Node ESM 해석 (config TS 파일 import 시 일관성↑)
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],

    // configs는 TS 전용으로 운용
    "allowJs": false,

    // JSON 설정을 TS에서 참조할 수 있게
    "resolveJsonModule": true,

    // 일부 툴이 Node 전역타입을 기대할 수 있어 명시
    "types": ["node"],

    // 편의/안전
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // 선언 파일 및 소스맵 생성
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // 증분 빌드 캐시
    "incremental": true,
    "tsBuildInfoFile": "../../dist/packages/configs/.tsbuildinfo"
  },

  // 포함 범위
  "include": ["src/**/*", "src/**/*.json"],

  // 불필요한 폴더 제외
  "exclude": ["dist", "node_modules"],

  // Project References 필요 없음 (다른 패키지를 참조하지 않음)
  "references": []
}
