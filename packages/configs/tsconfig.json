{
  // 루트의 tsconfig.json 상속
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true
  },
  "include": [
    "**/*.js",
    "**/*.json",
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
