/**
 * Description : tsconfig.json - 📌 Logger 패키지 (TypeScript 설정)
 * Author : Shiwoo Min
 * Date : 2025-09-10
 */
{
  // 루트의 tsconfig.base.json 상속
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // I/O 경로
    "rootDir": "./src",
    "outDir": "../../dist/packages/logger",

    // Node ESM 권장
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,

    // 서버 전용 타깃
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node"],

    // 타입 선언 및 소스맵
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // 모노레포 최적화
    "incremental": true,
    "tsBuildInfoFile": "../../dist/packages/logger/.tsbuildinfo",

    // CJS 호환
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": false,

    // 품질/편의
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true
  },

  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "**/*.test.*", "**/*.spec.*"]
}
