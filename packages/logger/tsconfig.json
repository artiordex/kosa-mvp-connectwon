/**
 * Description : tsconfig.json - 📌 logger 패키지용 TS 설정
 * Author : Shiwoo Min
 * Date : 2025-09-08
 */
{
  // 루트 tsconfig를 상속
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "moduleResolution": "NodeNext",

    // 품질/호환 옵션 권장
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },

  "include": [
    "src"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ],

  // 프로젝트 참조 설정
  "references": []
}
