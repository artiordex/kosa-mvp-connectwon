/**
 * Description : tsconfig.json - 📌 Logger 패키지
 * Author : Shiwoo Min
 * Date : 2025-10-09
 *
 * Environment :
 *  - Docker / Cloud Run / Firebase / Azure / Local 개발환경 완전 호환
 *  - ESM 기반 (NodeNext) + 번들러 호환 (Nx tsc executor)
 *
 * Note :
 *  - Winston 기반 로깅 (File, Console, Cloud stdout 통합)
 *  - winston-daily-rotate-file 및 custom transport 사용 가능
 *  - 빌드 로그 : tsc -p tsconfig.json --listEmittedFiles
 */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,

    // 출력 설정
    "rootDir": "./src",
    "outDir": "../../dist/packages/logger",
    "declarationDir": "../../dist/packages/logger",
    "tsBuildInfoFile": "../../dist/packages/logger/.tsbuildinfo",

    // NodeNext / Bundler 해석
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022"],
    "verbatimModuleSyntax": true,

    // 선언 및 디버깅
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,

    // Node 환경
    "types": ["node"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    // 품질
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "exactOptionalPropertyTypes": true,

    // 내부 경로 alias
    "baseUrl": "./",
    "paths": {
      "@connectwon/logger/*": ["src/*"],
      "@connectwon/logger-types": ["src/logger-types.ts"]
    }
  },

  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "**/*.test.*", "**/*.spec.*"]
}
