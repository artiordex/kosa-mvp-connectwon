{
  "name": "@connectwon/logger",
  "sourceRoot": "packages/logger/src",
  "projectType": "library",
  "tags": ["type:lib", "layer:shared"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "main": "packages/logger/src/index.ts",
        "outputPath": "dist/packages/logger",
        "tsConfig": "packages/logger/tsconfig.json",
        "assets": ["packages/logger/package.json", "packages/logger/README.md", "packages/logger/LICENSE"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["packages/logger/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "options": {
        "passWithNoTests": true,
        "configFile": "packages/logger/vitest.config.ts"
      }
    }
  }
}
