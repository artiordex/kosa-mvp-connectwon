{
  "name": "@connectwon/logger",
  "version": "1.0.0",
  "description": "ConnectWon 로거 모듈 (Winston 기반)",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/**/*.js"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/packages/logger/index.d.ts",
      "import": "./dist/packages/logger/index.js"
    },
    "./logger-types": {
      "types": "./dist/packages/logger/logger-types.d.ts",
      "import": "./dist/packages/logger/logger-types.js"
    },
    "./package.json": "./package.json"
  },
  "__comment_scripts": "빌드/개발/배포 스크립트",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "__comment_dependencies": "실행 시 필요한 런타임 의존성",
  "dependencies": {
    "logform": "^2.7.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-transport": "^4.9.0"
  },
  "__comment_devDependencies": "개발/테스트/빌드용 의존성",
  "devDependencies": {
    "@types/node": "^24.3.1",
    "eslint": "^9.36.0",
    "rimraf": "^6.0.1",
    "typescript": "5.6.3",
    "vitest": "^3.2.4"
  },
  "__comment_engines": "런타임/패키지 매니저 버전 요구사항",
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=10.7.0"
  }
}
