{
  "name": "@connectwon/logger",
  "version": "1.0.0",
  "description": "ConnectWon 로깅 모듈 (Winston 기반 - Cloud/Local/Container 공용)",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/**/*.js"
  ],
  "files": ["dist"],

  "__comment_exports": "ESM/TS 타입 정의 - Docker / Cloud Run / Firebase / Azure / Local 개발환경 완전 호환",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./logger-types": {
      "types": "./dist/logger-types.d.ts",
      "import": "./dist/logger-types.js"
    },
    "./package.json": "./package.json"
  },

  "__comment_scripts": "빌드/개발/배포 스크립트",
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },

  "__comment_dependencies": "런타임 로깅 의존성 (Cloud-ready Winston Stack)",
  "dependencies": {
    "logform": "^2.7.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-transport": "^4.9.0"
  },

  "__comment_devDependencies": "개발/테스트/빌드용 의존성",
  "devDependencies": {
    "@types/node": "^24.3.1",
    "eslint": "^9.36.0",
    "rimraf": "^6.0.1",
    "typescript": "5.6.3",
    "vitest": "^3.2.4"
  },

  "__comment_nx": "Nx 그래프 자동 종속 관리 (core/database 등에서 사용 가능)",
  "nx": {
    "implicitDependencies": [],
    "targets": {
      "build": {
        "dependsOn": []
      }
    }
  },

  "__comment_engines": "Node 20+ 런타임 보장 (Docker / Cloud Run / Firebase / Azure / Local)",
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=10.7.0"
  }
}
