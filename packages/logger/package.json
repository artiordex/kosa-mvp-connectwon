{
  "name": "@connectwon/logger",
  "version": "1.0.0",
  "description": "ConnectWon 로거 모듈 (Winston 기반)",
  "private": false,
  "type": "module",
  "sideEffects": [
    "./dist/logger.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./logger-types": {
      "types": "./dist/logger-types.d.ts",
      "import": "./dist/logger-types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch -p tsconfig.json",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm run build",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "logform": "^2.7.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.0",
    "eslint": "^9.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=9.0.0"
  }
}
