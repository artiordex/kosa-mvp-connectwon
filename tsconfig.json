/**
 * Description : tsconfig.json - 📌 모노레포 전체를 위한 통합 TypeScript 설정
 * Author : Shiwoo Min
 * Date : 2025-09-07
 * 참고 명령어:
 *   npx tsc --project tsconfig.json --showConfig
 */
{
  "extends": "./tsconfig.base.json",

  "compilerOptions": {
    // 절대경로 import를 위한 기준 디렉터리
    "baseUrl": ".",

    // 타입 정의 파일 경로 지정
    // (모노레포에선 기본 탐색이 더 안전하므로 비활성화)
    // "typeRoots": ["./node_modules/@types"],

    // 타입 선언 파일(.d.ts) 관련
    // "declarationMap": true,

    // 모노레포에서 빌드 성능 향상을 위한 증분 빌드 정보 파일
    "tsBuildInfoFile": "./dist/.tsbuildinfo",

    // JSON 모듈 import 지원
    "resolveJsonModule": true,

    // CommonJS 모듈을 ES6 스타일로 import/export 가능
    "esModuleInterop": true,

    // 외부 라이브러리의 타입 검사 건너뜀(빌드 속도 향상)
    "skipLibCheck": true,

    // default import 지원 (esModuleInterop과 함께 사용 권장)
    "allowSyntheticDefaultImports": true,

    // import/export 구문을 원본 그대로 유지 (Next.js 호환 ↑)
    // "verbatimModuleSyntax": true,

    // 파일명 대소문자 일관성 검사 (대소문자 오류 방지)
    "forceConsistentCasingInFileNames": true,

    // 컴파일 에러 시 .js 파일 출력 여부
    "noEmitOnError": false,

    // ESM/번들러 모듈에러 방지를 위한 주석처리
    // "module": "ESNext",
    // "moduleResolution": "Bundler",

    // 런타임 타깃/라이브러리
    "target": "ES2022",

    // 사용하지 않는 코드에 대한 경고 비활성화
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    // JSX 변환 설정 (Next.js 호환)
    "jsx": "react-jsx",

    // 빌드 산출물 타깃 라이브러리
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    // 경로 별칭은 tsconfig.base.json에서 통합 관리
    // "paths": { ... },

    // 엄격 모드 설정
    "strict": true,

    // TS5 ESM 감지 강화 (권장)
    "moduleDetection": "force"
  },

  // 루트 프로젝트는 빈 파일 배열 - references로만 관리
  "files": [],

  // TypeScript Project References로 의존성 관리
  "references": [
    { "path": "./packages/api-contract" },
    { "path": "./packages/configs" },
    { "path": "./packages/core" },
    { "path": "./packages/database" },
    { "path": "./packages/logger" },
    { "path": "./packages/sdk" },
    { "path": "./packages/ui" }
    // Removed reference to './packages/types' as it does not exist
  ]
}
