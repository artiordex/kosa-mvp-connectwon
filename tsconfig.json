/**
 * Description : tsconfig.json - 📌 모노레포 전체를 위한 통합 TypeScript 설정
 * Author : Shiwoo Min
 * Date : 2025-09-07
 *
 * 참고 명령어:
 *   npx tsc --project tsconfig.json --showConfig
 */
{
  "extends": "./tsconfig.base.json",

  "compilerOptions": {
    // 절대경로 import를 위한 기준 디렉터리
    "baseUrl": ".",

    // 타입 정의 파일 경로 지정
    "typeRoots": ["./node_modules/@types"],

    // 타입 선언 파일(.d.ts) 관련
    // "declarationMap": true,

    // 모노레포에서 빌드 성능 향상을 위한 증분 빌드 정보 파일
    "tsBuildInfoFile": "./dist/.tsbuildinfo",

    // JSON 모듈 import 지원
    "resolveJsonModule": true,

    // CommonJS 모듈을 ES6 스타일로 import/export 가능
    "esModuleInterop": true,

    // 외부 라이브러리의 타입 검사 건너뜀(빌드 속도 향상)
    "skipLibCheck": true,

    // default import 지원 (esModuleInterop과 함께 사용 권장)
    "allowSyntheticDefaultImports": true,

    // import/export 구문을 원본 그대로 유지 (Next.js 호환 ↑)
    // "verbatimModuleSyntax": true,

    // 파일명 대소문자 일관성 검사 (대소문자 오류 방지)
    "forceConsistentCasingInFileNames": true,

    // 컴파일 에러 시 .js 파일 출력 여부
    "noEmitOnError": false,

    // ESM/번들러 친화 모듈 해석(Next.js/Vite 호환 ↑)
    "module": "ESNext",
    "moduleResolution": "Bundler",

    // 런타임 타깃/라이브러리
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],

    // 경로 별칭 설정 - 실제 존재하는 패키지들만
    "paths": {
      // 환경변수 설정
      "@connectwon/env": ["./connectwon-env.ts"],

      // API 계약
      "@connectwon/api-contract": ["packages/api-contract/src/index.ts"],
      "@connectwon/api-contract/*": ["packages/api-contract/src/*"],

      // 설정 (src 폴더가 없다면 루트에서 직접)
      "@connectwon/configs": ["packages/configs/index.ts"],
      "@connectwon/configs/*": ["packages/configs/*"],

      // 핵심 기능
      "@connectwon/core": ["packages/core/src/index.ts"],
      "@connectwon/core/*": ["packages/core/src/*"],

      // 데이터베이스
      "@connectwon/database": ["packages/database/src/index.ts"],
      "@connectwon/database/*": ["packages/database/src/*"],

      // 로거 (src 폴더 확인 필요)
      "@connectwon/logger": ["packages/logger/src/index.ts"],
      "@connectwon/logger/*": ["packages/logger/src/*"],

      // SDK
      "@connectwon/sdk": ["packages/sdk/src/index.ts"],
      "@connectwon/sdk/*": ["packages/sdk/src/*"],

      // UI 라이브러리
      "@connectwon/ui": ["packages/ui/src/index.ts"],
      "@connectwon/ui/*": ["packages/ui/src/*"]
    },
    // 엄격 모드 설정
    "strict": true
  },

  // 루트 프로젝트는 빈 파일 배열 - references로만 관리
  "files": [

  ],

  // TypeScript Project References로 의존성 관리
  "references": [
    { "path": "./packages/configs" },
    { "path": "./packages/logger" },
    { "path": "./packages/database" },
    { "path": "./packages/api-contract" },
    { "path": "./packages/core" },
    { "path": "./packages/sdk" },
    { "path": "./packages/ui" }
    // Removed reference to './packages/types' as it does not exist
  ]
}
