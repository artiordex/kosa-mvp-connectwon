/**
 * Description : tsconfig.json - 📌 모노레포 전체 통합 TypeScript 설정 (집계 전용)
 * Author : Shiwoo Min
 * Date : 2025-09-07
 * 10-01 : 루트 tsconfig.json을 noEmit + references 전용으로 단순화
 * 10-08 : composite 추가, include 명시, references 주석 구조 정리
 * 참고 명령어:
 *   pnpm -w exec tsc --project tsconfig.json --showConfig
 */
{
  "extends": "./tsconfig.base.json",

  "compilerOptions": {
    // 절대경로 import 기준
    "baseUrl": ".",

    // JSON import 허용
    "resolveJsonModule": true,

    // CommonJS ↔ ESModule 호환
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    // 외부 라이브러리 타입 검사 스킵 (빌드 속도 ↑)
    "skipLibCheck": true,

    // 파일명 대소문자 일관성 검사
    "forceConsistentCasingInFileNames": true,

    // 산출물 생성 금지 (루트는 타입체크 전용)
    "noEmit": true,

    // Project References 활성화
    "composite": true,

    // 엄격 모드 공통 적용
    "strict": true,

    // TS5 ESM 감지 강화
    "moduleDetection": "force"
  },

  // 루트는 직접 소스 포함하지 않음
  "files": [],
  "include": [],

  // Project References (모노레포 구성요소)
  "references": [
    // packages
    { "path": "./packages/api-contract" },
    { "path": "./packages/configs" },
    { "path": "./packages/core" },
    { "path": "./packages/database" },
    { "path": "./packages/logger" },
    { "path": "./packages/sdk" },
    { "path": "./packages/server" },
    { "path": "./packages/client" },
    { "path": "./packages/ui" },

    // apps
    { "path": "./apps/web" },
    { "path": "./apps/admin" },
    { "path": "./apps/api" },
    { "path": "./apps/worker" },
    { "path": "./apps/e2e" }
  ]
}
