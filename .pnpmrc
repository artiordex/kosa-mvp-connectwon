# Description : .pnpmrc - 📌 PNPM 워크스페이스 패키지 호이스팅 설정
# Author : Shiwoo Min
# Date  : 2025-09-12
# 09-17 - 스타일링, 테스트, 코드 품질, ORM/DB 관련 패키지 호이스팅 추가
# 09-18 - TypeScript 라이브러리 오류 해결을 위한 shamefully-hoist 설정 추가
# 09-22 - pnpm v10 deploy 정책 대응 (inject-workspace-packages 추가)
# 09-22 - Docker 빌드 최적화 설정 추가 (네트워크, 캐시, 재시도)
# NOTE:
#   - public-hoist-pattern 설정을 통해 특정 패키지들을 루트 node_modules로 끌어올려
#     모든 워크스페이스에서 공유 사용 (중복 설치 방지, 버전 일관성 유지)
#   - auto-install-peers 설정을 통해 peer dependencies 자동 설치 활성화
#   - shamefully-hoist로 TypeScript 표준 라이브러리 접근 문제 해결
#   - pnpm v10 이후 deploy 시 inject-workspace-packages 필요

# 모든 @types/* 패키지들
public-hoist-pattern[]=*@types/*

# TypeScript 컴파일러 및 관련 도구들 공통 사용
public-hoist-pattern[]=typescript
public-hoist-pattern[]=ts-node
public-hoist-pattern[]=tsx

# ESLint 관련 패키지들 (플러그인, 설정 등) 통일
public-hoist-pattern[]=eslint*

# Prettier 포맷터 공통 사용
public-hoist-pattern[]=prettier

# Vitest 테스트 프레임워크 공유
public-hoist-pattern[]=vitest

# Vite 빌드 도구 공유
public-hoist-pattern[]=vite

# Playwright E2E 테스트 도구 및 관련 패키지들
public-hoist-pattern[]=playwright*

# NestJS 프레임워크 호이스팅
public-hoist-pattern[]=@nestjs/*

# peer dependencies 자동 설치
auto-install-peers=true

# 스타일링
public-hoist-pattern[]=postcss
public-hoist-pattern[]=tailwindcss

# 코드 품질
public-hoist-pattern[]=lint-staged
public-hoist-pattern[]=husky

# ORM/DB
public-hoist-pattern[]=prisma

# 호이스팅 방식 설정 (TypeScript 라이브러리 오류 해결)
node-linker=hoisted
shamefully-hoist=true

# pnpm v10 deploy 정책 대응
inject-workspace-packages=true

# 심링크 관련 설정 (Docker/Windows 호환성 개선 필요 시 활성화)
symlink=false
prefer-symlinked-executables=false

# ===== Docker 빌드 최적화 설정 =====

# 네트워크 설정 (Docker 빌드 시 타임아웃 방지)
network-timeout=300000
fetch-timeout=300000
network-concurrency=4

# 재시도 설정 (네트워크 불안정 상황 대응)
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000

# 레지스트리 설정
registry=https://registry.npmjs.org/

# 캐시 설정 (Docker 레이어 캐싱 최적화)
store-dir=.pnpm-store
cache-dir=.pnpm-cache

# 로그 레벨 (빌드 디버깅용)
loglevel=info
progress=true

# 패키지 관리 엄격성
package-manager-strict=false

# 워크스페이스 설정
link-workspace-packages=true
prefer-workspace-packages=true

# 보안 설정
audit-level=moderate
fund=false

# 빌드 최적화
save-exact=false
package-import-method=auto

# lockfile 설정 (CI/CD 안정성)
frozen-lockfile=false
