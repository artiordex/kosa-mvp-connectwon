{
  // React 컴포넌트 (Next/TS 친화)
  "React Component": {
    "scope": "typescriptreact,javascriptreact",
    "prefix": "rfc",
    "description": "React 함수 컴포넌트 기본 골격(Next.js 친화)",
    "body": [
      "${1|'use client';,|}",
      "interface ${2:Component}Props {",
      "  ${3:// props}",
      "}",
      "",
      "export function ${2:Component}(${4:props}: ${2:Component}Props): JSX.Element {",
      "  return (",
      "    <div className=\"${5:container}\">${6:content}</div>",
      "  );",
      "}"
    ]
  },

  // React Hook - useState
  "React useState": {
    "scope": "typescriptreact,javascriptreact",
    "prefix": "ustate",
    "description": "useState Hook",
    "body": [
      "const [${1:state}, set${1/(.*)/${1:/capitalize}/}] = useState${2|<string>,<number>,<boolean>,<any>,|}(${3:initialValue});"
    ]
  },

  // React Hook - useEffect
  "React useEffect": {
    "scope": "typescriptreact,javascriptreact",
    "prefix": "ueffect",
    "description": "useEffect Hook",
    "body": [
      "useEffect(() => {",
      "  ${1:// effect}",
      "  ${2|,return () => {\\n    // cleanup\\n  };|}",
      "}, [${3:dependencies}]);"
    ]
  },

  // Next.js App Router - Page
  "Next.js Page": {
    "scope": "typescriptreact",
    "prefix": "nextpage",
    "description": "Next.js App Router 페이지 컴포넌트",
    "body": [
      "import { Metadata } from 'next';",
      "",
      "export const metadata: Metadata = {",
      "  title: '${1:Page Title}',",
      "  description: '${2:Page Description}'",
      "};",
      "",
      "export default function ${3:Page}() {",
      "  return (",
      "    <div className=\"${4:container}\">",
      "      <h1>${5:Page Content}</h1>",
      "    </div>",
      "  );",
      "}"
    ]
  },

  // Next.js App Router - Layout
  "Next.js Layout": {
    "scope": "typescriptreact",
    "prefix": "nextlayout",
    "description": "Next.js App Router 레이아웃 컴포넌트",
    "body": [
      "export default function ${1:Root}Layout({",
      "  children,",
      "}: {",
      "  children: React.ReactNode;",
      "}) {",
      "  return (",
      "    <${2|html,div|}${3| lang=\"ko\",|}>",
      "      ${4:children}",
      "    </${2|html,div|}>",
      "  );",
      "}"
    ]
  },

