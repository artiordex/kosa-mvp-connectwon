/**
 * Description : launch.json - 📌 VS Code 디버그 및 테스트 실행 설정
 * Author : Shiwoo Min
 * Date : 2025-10-09
 * Note : Vitest, Playwright, NestJS API 디버깅, ESM/TS 경로 인식 강화
 */
{
  "version": "0.2.0",
  "configurations": [
    // Vitest: 단일 파일 디버그
    {
      "name": "Vitest - Current File (debug)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": [
        "run",
        "${file}",
        "--no-threads",
        "--watch=false",
        "--config",
        "vitest.config.ts"
      ],
      "envFile": "${workspaceFolder}/.env.test",
      "env": { "NODE_ENV": "test" },
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "sourceMaps": true,
      "autoAttachChildProcesses": true,
      "smartStep": true,
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },

    // Vitest: 전체 테스트 1회 실행
    {
      "name": "Vitest - Run All (once)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "--watch=false", "--config", "vitest.config.ts"],
      "envFile": "${workspaceFolder}/.env.test",
      "env": { "NODE_ENV": "test" },
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "sourceMaps": true,
      "autoAttachChildProcesses": true,
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },

    // Vitest: 워치 모드
    {
      "name": "Vitest - Watch",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["watch", "--config", "vitest.config.ts"],
      "envFile": "${workspaceFolder}/.env.test",
      "env": { "NODE_ENV": "test" },
      "sourceMaps": true,
      "autoAttachChildProcesses": true,
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },

    // Playwright: E2E - PC (headed)
    {
      "name": "Playwright E2E - PC (headed)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "args": [
        "test",
        "e2e/pc-web",
        "--headed",
        "--reporter=html",
        "--trace=retain-on-failure"
      ],
      "runtimeArgs": ["--require", "tsconfig-paths/register"],
      "envFile": "${workspaceFolder}/.env.test",
      "env": { "POC": "pc", "NODE_ENV": "test" },
      "sourceMaps": true,
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },

    // Playwright: E2E - PC (headless)
    {
      "name": "Playwright E2E - PC (headless)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "args": [
        "test",
        "e2e/pc-web",
        "--headless",
        "--reporter=dot"
      ],
      "envFile": "${workspaceFolder}/.env.test",
      "env": { "POC": "pc", "NODE_ENV": "test" },
      "sourceMaps": true,
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },

    // Playwright: API (headed)
    {
      "name": "Playwright E2E - API",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "args": [
        "test",
        "e2e/api",
        "--headed",
        "--reporter=html",
        "--trace=retain-on-failure"
      ],
      "runtimeArgs": ["--require", "tsconfig-paths/register"],
      "envFile": "${workspaceFolder}/.env.test",
      "env": { "POC": "api", "NODE_ENV": "test" },
      "sourceMaps": true,
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },

    // NestJS API 서버 디버깅
    {
      "name": "NestJS API - Debug",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "args": ["${workspaceFolder}/apps/api/src/main.ts"],
      "envFile": "${workspaceFolder}/.env",
      "env": { "NODE_ENV": "development" },
      "outFiles": ["${workspaceFolder}/dist/apps/api/**/*.js"],
      "sourceMaps": true,
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
