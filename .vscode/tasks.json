      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "new" },
      "options": { "cwd": "${workspaceFolder}" },
      "runOptions": { "reevaluateOnRerun": true }
    },
    {
      // Vitest 단위 테스트
      "label": "Test: Vitest Unit",
      "type": "shell",
      "command": "pnpm",
      "args": ["test:unit"],
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" },
      "options": { "cwd": "${workspaceFolder}" },
