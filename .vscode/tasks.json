/**
 * Description : tasks.json - 📌 VS Code에서 자동화 작업을 설정하는 파일
 * Author : Shiwoo Min
 * Date : 2025-09-09
 * 09-09: runOptions/cwd 보강, 패널 정책 정리
 */
{
  "version": "2.0.0",
  "tasks": [
    {
      // TypeScript 컴파일 (전체)
      "label": "Build: TypeScript",
      "type": "shell",
      "command": "pnpm",
      "args": ["build"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "silent", "panel": "shared" },
      // 작업 디렉토리 명시
      "options": { "cwd": "${workspaceFolder}" },
      // 재실행 안정화
      "runOptions": { "reevaluateOnRerun": true }
    },
    {
      // 개발 서버 시작 (웹)
      "label": "Dev: Web Server",
      "type": "shell",
      "command": "pnpm",
      "args": ["--filter", "@connectwon/web", "dev"],
      "group": "build",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "new" },
      "options": { "cwd": "${workspaceFolder}" },
      "runOptions": { "reevaluateOnRerun": true }
    },
    {
      // 개발 서버 시작 (API)
      "label": "Dev: API Server",
      "type": "shell",
      "command": "pnpm",
      "args": ["--filter", "@connectwon/api", "dev"],
      "group": "build",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "new" },
      "options": { "cwd": "${workspaceFolder}" },
      "runOptions": { "reevaluateOnRerun": true }
    },
    {
      // 전체 개발 서버 시작 (병렬)
      "label": "Dev: All Servers",
      "type": "shell",
      "command": "pnpm",
      "args": ["dev"],
      "group": "build",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "new" },
      "options": { "cwd": "${workspaceFolder}" },
      "runOptions": { "reevaluateOnRerun": true }
    },
    {
      // Playwright 테스트 실행
      "label": "Test: Playwright E2E",
      "type": "shell",
      "command": "pnpm",
