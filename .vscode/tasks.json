      "label": "Build: Production",
      "type": "shell",
      "command": "pnpm",
      "args": ["build:prod"],
      "group": "build",
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "always", "panel": "shared" },
      "options": { "cwd": "${workspaceFolder}" },
      "runOptions": { "reevaluateOnRerun": true }
    }
  ]
}
