# Description : .env.example - 📌 ConnectWon Environment 구성 탬플릿
# Author : Shiwoo Min
# Date : 2025-09-16
# 09-21 - 환경변수 추가 및 주석 보강

# 환경 설정
NODE_ENV=development
TZ=Asia/Seoul

# 서비스 포트 설정
WEB_PORT=3000
API_PORT=8000
ADMIN_PORT=3001
WORKER_PORT=3003
NGINX_PORT=80

# PostgreSQL 설정
POSTGRES_USER=sw
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=connectwon_db

# Prisma 데이터베이스 접속 정보 (연결 문자열은 실제 코드 또는 시크릿에서 생성 권장)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=${POSTGRES_DB}
DATABASE_USER=${POSTGRES_USER}
DATABASE_PASSWORD=${POSTGRES_PASSWORD}
DATABASE_SSL=false

# Connection Pool 설정
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis 설정 (Cache 및 Bull 큐용)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password
REDIS_DB=0
REDIS_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}"

# Bull Queue Redis 설정
QUEUE_REDIS_HOST=${REDIS_HOST}
QUEUE_REDIS_PORT=${REDIS_PORT}
QUEUE_REDIS_DB=1
QUEUE_REDIS_URL="redis://:${REDIS_PASSWORD}@${QUEUE_REDIS_HOST}:${QUEUE_REDIS_PORT}/${QUEUE_REDIS_DB}"

# 내부 Webhook Relay URL
INTERNAL_WEBHOOK_URL=http://localhost:4000/internal/webhook

# RedisInsight 포트
REDISINSIGHT_PORT=5540

# 인증 및 보안
JWT_SECRET=your_jwt_secret_key_with_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_different_from_jwt
JWT_REFRESH_EXPIRES_IN=30d

# 쿠키 관련
COOKIE_SECRET=your_cookie_secret_key_with_min_32_chars
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax

SESSION_SECRET=your_session_secret_key_with_min_32_chars
SESSION_MAX_AGE=86400000

# 외부 API 키 (빈값으로 두고 실제 키는 별도 관리)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=

# 결제 관련 키 (빈값)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 이메일 및 알림 설정
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=noreply@connectwon.com
SMTP_FROM_NAME=ConnectWon

# Slack 알림 설정
SLACK_WEBHOOK_URL=
SLACK_TOKEN=
SLACK_CHANNEL=#notifications

# Azure 스토리지 및 CDN 설정
AZURE_STORAGE_ACCOUNT=your_azure_storage_account
AZURE_STORAGE_ACCESS_KEY=your_azure_storage_access_key
AZURE_STORAGE_CONTAINER=your_storage_container_name
AZURE_CDN_ENDPOINT=your_azure_cdn_endpoint
AZURE_REGION=your_azure_region

# 로컬 업로드 설정
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# URL 및 CORS 설정
API_URL=http://localhost:${API_PORT}
WEB_URL=http://localhost:${WEB_PORT}
ADMIN_URL=http://localhost:${ADMIN_PORT}
FRONTEND_URL=${WEB_URL}
BACKEND_URL=${API_URL}
CORS_ORIGINS=${WEB_URL},${ADMIN_URL}

# 모니터링 및 로깅
LOG_LEVEL=debug
LOG_FORMAT=pretty
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=ConnectWon

# Grafana 모니터링
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_grafana_password
GF_SECURITY_SECRET_KEY=your_grafana_secret_key_min_32_chars
GF_SERVER_HTTP_PORT=3030
GF_SERVER_ROOT_URL=http://localhost:3030

# 비즈니스 설정
DEFAULT_RESERVATION_DURATION=60
MAX_ADVANCE_BOOKING_DAYS=30
CANCELLATION_DEADLINE_HOURS=24
OVERBOOKING_THRESHOLD=0.1

# 결제 & 포인트
PAYMENT_PROVIDER=stripe
PAYMENT_CURRENCY=KRW
PAYMENT_TIMEOUT_MINUTES=15
REFUND_POLICY_DAYS=7

POINTS_PER_KRW=0.01
SIGNUP_BONUS_POINTS=1000
REFERRAL_BONUS_POINTS=5000

# Rate Limiting 설정
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_IF_SUCCESSFUL=true
API_RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_HOUR=5

# 백그라운드 작업 및 스케줄
QUEUE_CONCURRENCY=5
JOB_ATTEMPTS=3
JOB_BACKOFF_TYPE=exponential
JOB_DELAY=5000

CLEANUP_JOB_CRON=0 2 * * *
NOTIFICATION_JOB_CRON=*/5 * * * *
BACKUP_JOB_CRON=0 3 * * 0

# Feature Flags
FEATURE_AI_RECOMMENDATIONS=true
FEATURE_PAYMENT_GATEWAY=true
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_SLACK_NOTIFICATIONS=false
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_BETA_FEATURES=false

# Playwright / 테스트 설정
CI=false
HEADLESS=true
BASE_URL=http://localhost:${WEB_PORT}
ACTION_TIMEOUT=30
NAVIGATION_TIMEOUT=60
SLOW_MO=100
BROWSER_LAUNCH_TIMEOUT=60000
START_WEB_SERVER=false
WEB_COMMAND=pnpm dev

TEST_DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/connectwon_test"
TEST_REDIS_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/15"

TEST_USER_EMAIL=test@connectwon.com
TEST_USER_PASSWORD=test123456
TEST_ADMIN_EMAIL=admin@connectwon.com
TEST_ADMIN_PASSWORD=admin123456

# Docker 및 인프라 설정
COMPOSE_PROJECT_NAME=connectwon
COMPOSE_FILE=infra/docker/docker-compose.yml

API_HEALTH_URL=${API_URL}/health
WEB_HEALTH_URL=${WEB_URL}
ADMIN_HEALTH_URL=${ADMIN_URL}

POSTGRES_EXTERNAL_PORT=5432
REDIS_EXTERNAL_PORT=6379

# n8n 설정
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:${N8N_PORT}/
N8N_DB_NAME=n8n
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_secure_n8n_password
N8N_ENCRYPTION_KEY=your_n8n_encryption_key_min_32_chars
N8N_EXECUTIONS_TIMEOUT=3600
N8N_EXECUTIONS_MAX_TIMEOUT=14400
N8N_LOG_LEVEL=info

# Analytics
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
MIXPANEL_TOKEN=

# Social OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Additional Services
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FCM_SERVER_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 회사 및 로케일 정보
COMPANY_NAME=ConnectWon
COMPANY_EMAIL=contact@connectwon.com
COMPANY_PHONE=+82-2-1234-5678
SUPPORT_EMAIL=support@connectwon.com

DEFAULT_TIMEZONE=Asia/Seoul
DATE_FORMAT=YYYY-MM-DD
TIME_FORMAT=HH:mm
DEFAULT_LANGUAGE=ko
SUPPORTED_LANGUAGES=ko,en
USE_I18N=true
