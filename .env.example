# Description : .env.example - 📌 ConnectWon Environment 구성 탬플릿
# Author : Shiwoo Min
# Date : 2025-09-16

# 환경 설정
NODE_ENV=development
TZ=Asia/Seoul

# 서비스 Ports
WEB_PORT=3000
API_PORT=8000
ADMIN_PORT=3001
WORKER_PORT=3003
NGINX_PORT=80

# DB PostgreSQL
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=connectwon_db

# Prisma
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=${POSTGRES_DB}
DATABASE_USER=${POSTGRES_USER}
DATABASE_PASSWORD=${POSTGRES_PASSWORD}
DATABASE_SSL=false
DATABASE_URL="postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}"

# Connection Pool
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis (Cache & Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
REDIS_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}"

# Bull Queue
QUEUE_REDIS_HOST=${REDIS_HOST}
QUEUE_REDIS_PORT=${REDIS_PORT}
QUEUE_REDIS_DB=1
QUEUE_REDIS_URL="redis://:${REDIS_PASSWORD}@${QUEUE_REDIS_HOST}:${QUEUE_REDIS_PORT}/${QUEUE_REDIS_DB}"

# RedisInsight
REDISINSIGHT_PORT=5540

# Auth & Security
JWT_SECRET=your_super_secure_jwt_secret_key_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secure_refresh_key_different_from_jwt
JWT_REFRESH_EXPIRES_IN=30d

# Cookie Settings
COOKIE_SECRET=your_super_secure_cookie_key_min_32_chars
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax

SESSION_SECRET=your_super_secure_session_secret_key_min_32_chars
SESSION_MAX_AGE=86400000

# 외부 API Keys
OPENAI_API_KEY=sk-your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
HUGGINGFACE_API_KEY=hf_your_huggingface_token_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Email / Notifications
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM_EMAIL=noreply@connectwon.com
SMTP_FROM_NAME=ConnectWon

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL=#notifications

# Storage & CDN
AWS_ACCESS_KEY_ID=AKIA_YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=connectwon-files-dev
AWS_S3_PUBLIC_BUCKET=connectwon-public-dev
AWS_CLOUDFRONT_DOMAIN=your_cloudfront_domain.cloudfront.net

# 로컬 저장 (개발용)
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# 앱 URL/CORS
API_URL=http://localhost:${API_PORT}
WEB_URL=http://localhost:${WEB_PORT}
ADMIN_URL=http://localhost:${ADMIN_PORT}
FRONTEND_URL=${WEB_URL}
BACKEND_URL=${API_URL}
CORS_ORIGINS=${WEB_URL},${ADMIN_URL}

# Monitoring & Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key
NEW_RELIC_APP_NAME=ConnectWon

# Grafana (모니터링)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_grafana_secure_password
GF_SECURITY_SECRET_KEY=your_grafana_secret_key_min_32_chars
GF_SERVER_HTTP_PORT=3030
GF_SERVER_ROOT_URL=http://localhost:3030

# 비즈니스 설정
DEFAULT_RESERVATION_DURATION=60
MAX_ADVANCE_BOOKING_DAYS=30
CANCELLATION_DEADLINE_HOURS=24
OVERBOOKING_THRESHOLD=0.1

# payment & points
PAYMENT_PROVIDER=stripe
PAYMENT_CURRENCY=KRW
PAYMENT_TIMEOUT_MINUTES=15
REFUND_POLICY_DAYS=7

POINTS_PER_KRW=0.01
SIGNUP_BONUS_POINTS=1000
REFERRAL_BONUS_POINTS=5000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_IF_SUCCESSFUL=true
API_RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_HOUR=5

# Background Jobs & Scheduling
QUEUE_CONCURRENCY=5
JOB_ATTEMPTS=3
JOB_BACKOFF_TYPE=exponential
JOB_DELAY=5000

CLEANUP_JOB_CRON=0 2 * * *
NOTIFICATION_JOB_CRON=*/5 * * * *
BACKUP_JOB_CRON=0 3 * * 0

# Feature Flags
FEATURE_AI_RECOMMENDATIONS=true
FEATURE_PAYMENT_GATEWAY=true
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_SLACK_NOTIFICATIONS=false
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_BETA_FEATURES=false

# Playwright/테스트
CI=false
HEADLESS=true
BASE_URL=http://localhost:${WEB_PORT}
ACTION_TIMEOUT=30
NAVIGATION_TIMEOUT=60
SLOW_MO=100
BROWSER_LAUNCH_TIMEOUT=60000
START_WEB_SERVER=false
WEB_COMMAND=pnpm dev

TEST_DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/connectwon_test"
TEST_REDIS_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/15"

TEST_USER_EMAIL=test@connectwon.com
TEST_USER_PASSWORD=test123456
TEST_ADMIN_EMAIL=admin@connectwon.com
TEST_ADMIN_PASSWORD=admin123456

# Docker & Infra
COMPOSE_PROJECT_NAME=connectwon
COMPOSE_FILE=infra/docker/docker-compose.yml

API_HEALTH_URL=${API_URL}/health
WEB_HEALTH_URL=${WEB_URL}
ADMIN_HEALTH_URL=${ADMIN_URL}

POSTGRES_EXTERNAL_PORT=5432
REDIS_EXTERNAL_PORT=6379

# n8n
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:${N8N_PORT}/
N8N_DB_NAME=n8n
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_secure_n8n_password
N8N_ENCRYPTION_KEY=your_n8n_encryption_key_min_32_chars
N8N_EXECUTIONS_TIMEOUT=3600
N8N_EXECUTIONS_MAX_TIMEOUT=14400
N8N_LOG_LEVEL=info

# Analytics
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX-X
GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX
MIXPANEL_TOKEN=your_mixpanel_token

# Social OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
KAKAO_CLIENT_ID=your_kakao_app_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# Additional Services
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
FCM_SERVER_KEY=your_firebase_server_key
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Company / Locale
COMPANY_NAME=ConnectWon
COMPANY_EMAIL=contact@connectwon.com
COMPANY_PHONE=+82-2-1234-5678
SUPPORT_EMAIL=support@connectwon.com

DEFAULT_TIMEZONE=Asia/Seoul
DATE_FORMAT=YYYY-MM-DD
TIME_FORMAT=HH:mm
DEFAULT_LANGUAGE=ko
SUPPORTED_LANGUAGES=ko,en
USE_I18N=true
