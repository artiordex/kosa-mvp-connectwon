{
  "name": "connectwon",
  "version": "1.0.0",
  "description": "ConnectWon - 도전자들을 위한 예약 기반 생활 서비스",
  "private": true,
  "author": "Shiwoo Min",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=10.7.0"
  },
  "engineStrict": true,
  "packageManager": "pnpm@10.7.0",
  "__comment_scripts": "pnpm scripts 명령어",
  "scripts": {
    "dev:compose": "docker compose -p connectwon --env-file .env -f infra/docker/docker-compose.yml up -d --build",
    "dev:web": "pnpm --filter @connectwon/web dev",
    "dev:admin": "pnpm --filter @connectwon/admin dev",
    "dev:api": "pnpm --filter @connectwon/api dev",
    "dev:worker": "pnpm --filter @connectwon/worker dev",
    "dev:infra": "docker compose -f infra/docker/docker-compose.yml up -d postgres redis",
    "down:infra": "docker compose -f infra/docker/docker-compose.yml down",
    "dev:all": "concurrently \"pnpm run dev:web\" \"pnpm run dev:admin\" \"pnpm run dev:api\" \"pnpm run dev:worker\"",
    "dev:stack": "run-s dev:infra prisma:generate db:migrate db:seed dev:all",
    "build:tsc": "tsc -b -v tsconfig.json",
    "build:packages": "pnpm -r --filter \"./packages/*\" run build",
    "build:api": "pnpm --filter @connectwon/api run build",
    "build:all": "nx run-many -t build",
    "test:unit": "nx run-many -t test --parallel",
    "test:e2e": "nx run e2e:test",
    "test:all": "pnpm run test:unit && pnpm run test:e2e",
    "test:watch": "nx run-many -t test --parallel --watch",
    "test:coverage": "nx run-many -t test --parallel --coverage",
    "db:migrate": "pnpm --filter @connectwon/database exec prisma migrate dev --name init",
    "db:seed": "pnpm --filter @connectwon/database exec tsx src/utils.ts seed",
    "prisma:generate": "pnpm --filter @connectwon/database run prisma:generate",
    "lint": "nx run-many -t lint --parallel",
    "lint:fix": "eslint --ext .ts,.tsx . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\"",
    "check-unused": "knip",
    "prepare": "node -e \"process.exit(require('fs').existsSync('.git')?0:0)\" && husky install",
    "commit": "cz",
    "sync": "syncpack lint && syncpack fix-mismatches",
    "graph": "nx graph"
  },
  "__comment_devDependencies": "개발용 의존성 모음",
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "@eslint/js": "^9",
    "@nrwl/node": "^19.8.4",
    "@nx/eslint": "^21.4.1",
    "@nx/eslint-plugin": "^21.4.1",
    "@nx/js": "^21.5.2",
    "@nx/next": "^21.5.2",
    "@nx/node": "^21.5.2",
    "@nx/vite": "^21.5.2",
    "@nx/webpack": "^21.5.2",
    "@nx/workspace": "^21.5.2",
    "@playwright/test": "^1.51.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^24.5.2",
    "@types/react": "^18.3.7",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/ui": "^3.2.4",
    "changesets": "^1.0.2",
    "commitizen": "^4.3.1",
    "concurrently": "^9.2.1",
    "cspell": "^6.27.0",
    "cz-customizable": "^7.4.0",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-playwright": "^0.16.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-testing-library": "^5.10.4",
    "eslint-plugin-unused-imports": "^3.2.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "knip": "^5.63.1",
    "lint-staged": "^15.5.2",
    "msw": "^2.7.4",
    "next": "15.5.4",
    "npm-run-all": "^4.1.5",
    "nx": "^21.4.1",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.2.8",
    "rimraf": "^6.0.0",
    "supertest": "^7.1.0",
    "syncpack": "^13.0.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "__comment_lintStaged": "커밋 전에 실행할 lint-staged 설정",
  "lint-staged": {
    "*.{ts,tsx,js,json}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "__comment_commitizenConfig": "커밋 메시지 표준화 도구 설정",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./.cz-config.cjs"
    }
  },
  "__comment_pnpmOverrides": "pnpm 패키지 버전 강제 override 설정",
  "pnpm": {
    "overrides": {
      "@nestjs/swagger": "^11.2.0",
      "bullmq": "^5.58.5",
      "ioredis": "^5.7.0",
      "winston": "^3.17.0",
      "@types/node": "^24.3.1",
      "typescript": "^5.9.2",
      "@types/react": "18.3.7",
      "@types/react-dom": "18.3.0"
    }
  },
  "__comment_useful_commands": "개발 및 배포 관련 유용한 명령어 모음",
  "dependencies": {
    "dotenv": "^17.2.2",
    "framer-motion": "^12.23.15",
    "react-color": "^2.19.3",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.62.0",
    "react-query": "^3.39.3",
    "zustand": "^4.4.2"
  }
}
