{
  "name": "connectwon",
  "version": "1.0.0",
  "description": "ConnectWon - 도전자들을 위한 예약 기반 생활 서비스",
  "private": true,
  "author": "Shiwoo Min",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=10.7.0"
  },
  "packageManager": "pnpm@10.7.0",
  "__comment_pnpm": "pnpm 및 워크스페이스 호이스팅 설정",
  "pnpm": {
    "overrides": {
      "next": "15.1.6",
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "@types/node": ">=24.3.1",
      "@nestjs/swagger": "^11.2.0",
      "bullmq": "^5.58.5",
      "ioredis": "^5.7.0",
      "winston": "^3.17.0",
      "supports-color": "8.1.1",
      "has-flag": "4.0.0"
    },
    "packageExtensions": {
      "eslint-config-prettier@*": {
        "peerDependencies": {
          "eslint": "*"
        }
      }
    },
    "hoistPattern": [
      "*"
    ],
    "strict-peer-dependencies": false,
    "link-workspace-packages": true,
    "shared-workspace-lockfile": true
  },
  "__comment_scripts": "pnpm scripts 명령어",
  "scripts": {
    "clean": "pnpm nx run-many -t clean --all || rimraf dist",
    "build": "pnpm run clean && pnpm nx run-many -t build --parallel",
    "postbuild": "tsx tools/services/postbuild.ts",
    "build:front": "pnpm nx run-many -t build --projects=@connectwon/ui,@connectwon/client --parallel && tsx tools/services/postbuild.ts && pnpm nx run-many -t build --projects=@connectwon/web,@connectwon/admin --parallel",
    "build:configs": "pnpm nx run @connectwon/configs:build",
    "build:api": "pnpm nx run @connectwon/api:build",
    "build:packages": "pnpm nx run-many -t build --projects @connectwon/*",
    "build:all": "pnpm run build",
    "build:admin": "cross-env NODE_ENV=production MAX_LISTENERS=50 pnpm nx build @connectwon/admin",
    "build:web": "cross-env NODE_ENV=production MAX_LISTENERS=50 pnpm nx build @connectwon/web",
    "firebase:login": "pnpm exec firebase login",
    "firebase:init": "pnpm exec firebase init",
    "firebase:deploy:web": "pnpm exec firebase deploy --only hosting:connectwon-web",
    "firebase:deploy:admin": "pnpm exec firebase deploy --only hosting:connectwon-admin",
    "firebase:deploy:all": "pnpm exec firebase deploy --only hosting:connectwon-web,hosting:connectwon-admin",
    "dev:compose": "docker compose -p connectwon --env-file .env -f infra/docker/docker-compose.yml up -d --build",
    "dev:infra": "docker compose -f infra/docker/docker-compose.yml up -d postgres redis",
    "down:infra": "docker compose -f infra/docker/docker-compose.yml down",
    "dev:web": "pnpm nx run @connectwon/web:serve",
    "dev:admin": "pnpm nx run @connectwon/admin:serve",
    "dev:api": "pnpm nx run @connectwon/api:serve",
    "dev:worker": "pnpm nx run @connectwon/worker:serve",
    "dev:all": "concurrently \"pnpm run dev:web\" \"pnpm run dev:admin\" \"pnpm run dev:api\" \"pnpm run dev:worker\"",
    "db:prepare": "pnpm nx run @connectwon/database:migrate:deploy && pnpm nx run @connectwon/database:generate",
    "dev:stack": "run-s dev:infra db:prepare dev:all",
    "build:tsc": "tsc -b -v tsconfig.json",
    "test:unit": "nx run-many -t test --parallel",
    "test:e2e": "nx run @connectwon/e2e:test",
    "test:all": "pnpm run test:unit && pnpm run test:e2e",
    "test:watch": "nx run-many -t test --parallel --watch",
    "test:coverage": "nx run-many -t test --parallel --coverage",
    "db:migrate": "pnpm nx exec @connectwon/database -- prisma migrate dev --name init",
    "db:seed": "pnpm nx exec @connectwon/database -- tsx src/utils.ts seed",
    "prisma:generate": "pnpm nx run @connectwon/database:prisma:generate",
    "lint": "nx run-many -t lint --parallel",
    "lint:fix": "eslint --ext .ts,.tsx . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,mdx}\"",
    "check-unused": "knip",
    "prepare": "npx husky install || true",
    "commit": "cz",
    "sync": "syncpack lint && syncpack fix-mismatches",
    "graph": "nx graph"
  },
  "__comment_devDependencies": "개발용 의존성 모음",
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "@eslint/js": "^9.9.0",
    "@nrwl/node": "^19.8.4",
    "@nx/eslint": "^21.6.2",
    "@nx/eslint-plugin": "^21.6.2",
    "@nx/js": "^21.6.2",
    "@nx/next": "^21.6.2",
    "@nx/node": "^21.6.2",
    "@nx/vite": "^21.6.2",
    "@nx/webpack": "^21.6.2",
    "@nx/workspace": "^21.6.2",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/eslint": "^9.6.1",
    "@types/node": "^24.3.1",
    "@types/react": "18.3.7",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "changesets": "^1.0.2",
    "commitizen": "^4.3.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "cspell": "^6.27.0",
    "cz-conventional-changelog": "^3.3.0",
    "cz-customizable": "^7.4.0",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-playwright": "^0.16.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-testing-library": "^5.10.4",
    "eslint-plugin-unused-imports": "^3.2.0",
    "firebase-tools": "^14.19.0",
    "has-flag": "4.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "knip": "^5.63.1",
    "lint-staged": "^15.5.2",
    "msw": "^2.7.4",
    "npm-run-all": "^4.1.5",
    "nx": "^21.6.2",
    "postcss": "^8.5.6",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.2.8",
    "rimraf": "^6.0.1",
    "shx": "^0.4.0",
    "supports-color": "8.1.1",
    "syncpack": "^13.0.4",
    "tailwindcss": "3.4.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.3",
    "typescript": "5.6.3",
    "vite": "^7.1.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "__comment_dependencies": "프로덕션용 의존성",
  "dependencies": {
    "@faker-js/faker": "^10.0.0",
    "@tanstack/react-query": "^5.51.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "firebase": "^12.3.0",
    "framer-motion": "^12.23.15",
    "react-color": "^2.19.3",
    "react-datepicker": "^8.7.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.62.0",
    "zustand": "^4.4.2"
  },
  "__comment_lintStaged": "커밋 전 lint-staged 설정",
  "lint-staged": {
    "apps/**/*.{ts,tsx,js,jsx,json,mdx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "packages/**/*.{ts,tsx,js,jsx,json,mdx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ]
  },
  "__comment_commitizenConfig": "Commitizen 및 커밋 템플릿 설정",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./.cz-config.cjs"
    }
  }
}
