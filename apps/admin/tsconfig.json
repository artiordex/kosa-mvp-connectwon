/**
 * Description : tsconfig.json - 📌 Next.js 기반 Admin 앱 (TypeScript 설정)
 * Author : Shiwoo Min
 * Date : 2025-09-11
 * 09-12 : 브라우저 번들러 해석(ESNext/Bundler), noEmit, 경로매핑 정리
 * 09-17 : TypeScript 컴파일 에러 해결을 위한 설정 추가
 */
{
  // 루트의 tsconfig.base.json 상속
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    // Next.js가 빌드/트랜스파일 처리 → TS는 타입체크 전용
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    // Next가 JSX 변환 담당 → preserve
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],

    // 패키지명(@connectwon/*)으로 임포트
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    // DOM 및 ES2022 API 사용
    "lib": ["dom", "dom.iterable", "ES2022"],
    "types": ["node"],

    // TypeScript 컴파일 에러 해결을 위한 설정들
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    // Strict 설정들 (필요에 따라 조정)
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "incremental": true
  },

  // Next 자동 생성 타입 선언 포함
  "include": ["next-env.d.ts", "src/**/*", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "out", "dist"]
}
