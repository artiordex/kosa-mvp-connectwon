/**
 * Description : tsconfig.json - 📌 Playwright 기반 E2E 모듈 (TypeScript 설정)
 * Author : Shiwoo Min
 * Date : 2025-09-07
 * 09-12 - include 범위 축소, DOM 타입 유지, noEmit 확정
 * 09-22 - Black-box: Project References 제거(불필요한 빌드 의존 차단), allowJs 기본 off
 */
{
  // 루트의 tsconfig.json 상속
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // I/O 경로
    "rootDir": "./src",
    "outDir": "../../dist/apps/e2e",

    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // 상호운용/편의
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": false,

    // 타입 전용(산출물 없음)
    "strict": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // Playwright/Node 타입
    "types": ["node", "@playwright/test"],

    // 자잘한 성능/안전
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },

  "include": [
    "src/**/*",
    "../playwright.config.ts"
  ],

  // 산출물/리포트/노드모듈 제외
  "exclude": ["node_modules", "dist", "test-results", "playwright-report"],
  "references": [
    { "path": "../../packages/logger" }
  ]
}
