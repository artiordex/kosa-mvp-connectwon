/**
 * Description : tsconfig.json - 📌 Playwright 기반 E2E 모듈 (TypeScript 설정)
 * Author : Shiwoo Min
 * Date : 2025-09-07
 * 09-12 - include 범위 축소, DOM 타입 유지, noEmit 확정
 * 09-22 - Black-box: Project References 제거(불필요한 빌드 의존 차단), allowJs 기본 off
 */
{
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    "baseUrl": ".",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // 테스트 러너는 Node, 자동화 대상은 브라우저 → ES + DOM 타입 병행
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    // 상호운용/편의
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": false,

    // 타입 전용(산출물 없음)
    "strict": true,
    "noEmit": true,

    // Playwright/Node 타입
    "types": ["node", "@playwright/test"],

    // 자잘한 성능/안전
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },

  // e2e 프로젝트 내부만 포함
  "include": ["playwright.config.ts", "e2e-types.ts", "setup.ts", "teardown.ts", "actions/**/*.ts", "locators/**/*.ts", "tests/**/*.ts", "../../packages/logger/src/**/*.ts"],

  // 산출물/리포트/노드모듈 제외
  "exclude": ["node_modules", "dist", "test-results", "playwright-report"]
}
