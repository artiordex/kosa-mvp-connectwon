{
  "name": "@connectwon/worker",
  "version": "1.0.0",
  "description": "ConnectWon 백그라운드 워커 서비스 (BullMQ 기반)",
  "private": true,
  "type": "module",
  "__comment_scripts": "pnpm scripts 명령어",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "nodemon --exec \"tsc && node dist/apps/worker/main.js\" --ext ts",
    "start": "node dist/apps/worker/main.js",
    "start:dev": "tsc -w -p tsconfig.json & nodemon dist/apps/worker/main.js",
    "start:prod": "NODE_ENV=production node dist/apps/worker/main.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.11"
  },
  "__comment_core_deps": "핵심 워커 의존성",
  "dependencies": {
    "@bull-board/api": "^6.13.0",
    "@bull-board/express": "^6.13.0",
    "@bull-board/ui": "^6.13.0",
    "bullmq": "^5.58.7",
    "ioredis": "^5.4.1",
    "@connectwon/core": "workspace:*",
    "@connectwon/database": "workspace:*",
    "@connectwon/logger": "workspace:*",
    "@connectwon/api-contract": "workspace:*",
    "@connectwon/sdk": "workspace:*",
    "nodemailer": "^6.9.16",
    "@slack/web-api": "^7.6.0",
    "prom-client": "^15.1.3",
    "node-cron": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "zod": "^3.23.8",
    "date-fns": "^4.1.0",
    "lodash": "^4.17.21"
  },
  "__comment_dev_deps": "개발 의존성",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.8.6",
    "@types/nodemailer": "^6.4.19",
    "@types/node-cron": "^3.0.11",
    "@types/lodash": "^4.17.12",
    "vitest": "^2.1.4",
    "@vitest/ui": "^2.1.4",
    "typescript": "^5.6.3",
    "nodemon": "^3.1.7",
    "tsx": "^4.19.2",
    "eslint": "^9.14.0",
    "@connectwon/configs": "workspace:*"
  },
  "__comment_peer_deps": "피어 의존성",
  "peerDependencies": {
    "redis": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "redis": {
      "optional": true
    }
  }
}
