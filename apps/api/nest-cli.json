{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": ["src/**/*.json", "src/**/*.md"],
    "watchAssets": true
  },
  "generateOptions": {
    "spec": false
  },
  "monorepo": true,
  "root": "apps/api"
}
