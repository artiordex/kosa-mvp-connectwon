{
  /**
   * Description : tsconfig.json - 📌 Nest/Express API 모듈 (TypeScript 설정)
   * Author : Shiwoo Min
   * Date : 2025-09-06
   * 09-12 : 소스맵/증분빌드/tsbuildinfo 추가, 라이브러리 스킵체크 활성화
   * 09-16 : Project References 추가, base 설정 상속으로 중복 제거
   */

  // 루트의 tsconfig.base.json 상속
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    // API 전용 출력 설정
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",

    // NestJS 데코레이터 필수 설정 (base에서 오버라이드)
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,

    // NestJS/Express 특화 설정
    "strictPropertyInitialization": false,

    // Node.js 환경 타입만 포함
    "types": ["node"]
  },

  // API 소스 파일만 포함
  "include": ["src/**/*"],

  // 모노레포 workspace 패키지 참조 (빌드 순서 보장)
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/database" },
    { "path": "../../packages/logger" },
    { "path": "../../packages/nest-kit" },
    { "path": "../../packages/api-contract" },
    { "path": "../../packages/sdk" }
  ],

  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
