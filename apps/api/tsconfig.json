{
  /**
   * Description : tsconfig.json - 📌 Nest API 모듈 (TypeScript 설정)
   * Author : Shiwoo Min
   * Date : 2025-09-06
   * 09-24 : watchOptions 테스트, base 상속 임시 제거
   * 빌드확인 : pnpm nx build @connectwon/api
   */
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    // API 전용 출력 설정
    "rootDir": "./src",
    "outDir": "../../dist/apps/api",
    "tsBuildInfoFile": "../../dist/apps/api/.tsbuildinfo",

    // ESM 모듈 설정
    "module": "es2022",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022"],

    // NestJS 데코레이터 필수 설정
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,

    // NestJS/Express 특화
    "strictPropertyInitialization": false,

    // verbatimModuleSyntax 비활성화 (CommonJS 호환성)
    "verbatimModuleSyntax": false,

    // 엄격함 완화 (NestJS 특성상)
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    // Node.js 타입 추가
    "types": ["node", "vitest"]
  },

  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS"
    }
  },

  // API 소스만 포함
  "include": ["src/**/*"],

  // 워크스페이스 패키지 참조 (package.json dependencies와 일치)
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/database" },
    { "path": "../../packages/logger" },
    { "path": "../../packages/api-contract" },
    { "path": "../../packages/server" },
    { "path": "../../packages/sdk" }
  ],

  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"]
}
