{
  "name": "@connectwon/api",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": ["type:app", "layer:backend", "platform:node"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "main": "apps/api/src/main.ts",
        "outputPath": "dist",
        "tsConfig": "apps/api/tsconfig.json",
        "assets": [
          { "input": "apps/api", "glob": "ecosystem.config.js", "output": "." },
          { "input": "apps/api/src", "glob": "**/*.yaml", "output": "./src" },
          { "input": "apps/api/src", "glob": "**/*.yml", "output": "./src" },
          { "input": "apps/api/src", "glob": "**/*.json", "output": "./src" },
          { "input": "apps/api/src", "glob": "**/*.proto", "output": "./src" }
        ]
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "api:build",
        "port": 8000
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/api/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "options": {
        "passWithNoTests": true
      }
    }
  },
  "implicitDependencies": ["@connectwon/core", "@connectwon/database", "@connectwon/logger", "@connectwon/api-contract"]
}
