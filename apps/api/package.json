{
  "name": "@connectwon/api",
  "version": "1.0.0",
  "description": "ConnectWon REST-API 기반 백엔드",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -w exec tsx watch apps/api/src/main.ts",
    "build": "pnpm -w exec tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "clean": "pnpm -w exec rimraf dist",
    "db:generate": "pnpm --filter=@connectwon/database generate",
    "db:migrate": "pnpm --filter=@connectwon/database migrate",
    "db:studio": "pnpm --filter=@connectwon/database studio"
  },
  "peerDependencies": {
    "@connectwon/database": "workspace:*",
    "bullmq": "^5.58.5"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.3",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "reflect-metadata": "^0.1.14",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.1",
    "@types/swagger-ui-express": "^4.1.8"
  },
  "engines": {
    "node": ">=20.11"
  }
}
