{
  "name": "@connectwon/web",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "tags": ["type:app", "layer:frontend", "platform:nextjs"],
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "options": {
        "outputPath": "dist/apps/web"
      }
    },
    "serve": {
      "executor": "@nx/next:dev",
      "options": {
        "port": 3000
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/web/**/*.ts", "apps/web/**/*.tsx"]
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "options": {
        "passWithNoTests": true
      }
    }
  },
  "implicitDependencies": ["@connectwon/ui", "@connectwon/client", "@connectwon/api-contract", "@connectwon/configs", "@connectwon/sdk"]
}
