/**
 * Description : tsconfig.json - 📌 Next.js 기반 Web 애플리케이션 (TypeScript 설정)
 * Author : Shiwoo Min
 * Date : 2025-09-06
 * 09-12 - 브라우저 번들러 해석(ESNext/Bundler), noEmit/Next 플러그인 추가, include 정리
 * 09-17 - TypeScript 컴파일 에러 해결을 위한 설정 추가
 */
{
  // 루트 공통 규칙 상속
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    // 브라우저 번들러 기준
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",

    // Next가 JSX 변환 담당 → preserve
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],

    // Web 전용 baseUrl 및 경로 alias
    "baseUrl": "src",
    "paths": {
      "components/*": ["components/*"],
      "data/*": ["data/*"],
      "lib/*": ["lib/*"],
    },

    // Next는 타입만 체크(noEmit)
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,

    // DOM API 타입 정의 포함
    "lib": ["dom", "dom.iterable", "es2022"],
    "types": ["node"],

    // TypeScript 컴파일 에러 해결
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,

    // Strict 설정
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    // CI 속도 ↑
    "incremental": true,
    "tsBuildInfoFile": "./.next/.tsbuildinfo"
  },

  "include": ["src/next-env.d.ts", "src/web-types.d.ts", "src", "ui.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
