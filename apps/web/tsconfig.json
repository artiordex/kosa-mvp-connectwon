/**
 * Description : tsconfig.json - 📌 Next.js 기반 Web 애플리케이션 (TypeScript 설정)
 * Author : Shiwoo Min
 * Date : 2025-09-06
 * 09-12 : 브라우저 번들러 해석(ESNext/Bundler), noEmit/Next 플러그인 추가, include 정리
 */
{
  // 루트 공통 규칙 상속
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    // 브라우저 번들러 기준
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",

    // 루트 paths 무력화(모노레포 src 직참조 방지, dist/exports만 사용)
    "paths": {},

    // Next는 타입만 체크(noEmit)
    "noEmit": true,
    "types": ["node"],
    "allowJs": true,
    "resolveJsonModule": true,

    // CI 속도 ↑
    "incremental": true,
    "tsBuildInfoFile": "./.next/.tsbuildinfo",

    // Next TS 플러그인
    "plugins": [{ "name": "next" }]
  },

  // Next가 추가하라고 했던 경로 포함
  "include": ["next-env.d.ts", "src", "ui.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
