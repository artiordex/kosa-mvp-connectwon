/**
 * Description : tsconfig.json - 📌 Next.js 기반 Web 애플리케이션 (TypeScript 설정)
 * Author : Shiwoo Min
 * Date : 2025-09-06
 * 09-12 - 브라우저 번들러 해석(ESNext/Bundler), noEmit/Next 플러그인 추가, include 정리
 * 09-17 - TypeScript 컴파일 에러 해결을 위한 설정 추가
 * 10-07 - dist 기반 workspace 패키지(@connectwon/*) 경로 추가
 * 10-09 - Docker / Cloud Run / Firebase / Azure / Local 완전 호환 버전
 */
{
  // 루트 공통 규칙 상속
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    // 브라우저 번들러 기준
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",

    // Next가 JSX 변환 담당 → preserve
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],

    // Web 전용 baseUrl 및 경로 alias
    "baseUrl": "src",
    "paths": {
      "@connectwon/core": ["../../dist/packages/core/index.d.ts"],
      "@connectwon/core/*": ["../../dist/packages/core/*"],
      "@connectwon/configs": ["../../dist/packages/configs/index.d.ts"],
      "@connectwon/configs/*": ["../../dist/packages/configs/*"],
      "@connectwon/logger": ["../../dist/packages/logger/index.d.ts"],
      "@connectwon/logger/*": ["../../dist/packages/logger/*"],
      "@connectwon/client": ["../../dist/packages/client/index.d.ts"],
      "@connectwon/client/*": ["../../dist/packages/client/*"],
      "@connectwon/ui": ["../../dist/packages/ui/index.d.ts"],
      "@connectwon/ui/*": ["../../dist/packages/ui/*"],
      "@connectwon/sdk": ["../../dist/packages/sdk/index.d.ts"],
      "@connectwon/sdk/*": ["../../dist/packages/sdk/*"],
      "@connectwon/api-contract": ["../../dist/packages/api-contract/index.d.ts"],
      "@connectwon/api-contract/*": ["../../dist/packages/api-contract/*"],
      "components/*": ["components/*"],
      "data/*": ["data/*"],
      "lib/*": ["lib/*"]
    },

    // Next는 타입만 체크(noEmit)
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,

    // DOM API 타입 정의 포함
    "lib": ["dom", "dom.iterable", "es2022"],
    "types": ["node"],

    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,

    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    "incremental": true,
    "tsBuildInfoFile": "./.next/.tsbuildinfo"
  },

  "include": ["src/next-env.d.ts", "src/web-types.d.ts", "src", "ui.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
