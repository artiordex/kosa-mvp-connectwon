/**
 * Description : tsconfig.json - 📌 Next.js 기반 Web 애플리케이션 (TypeScript 설정)
 * Author : Shiwoo Min
 * Date : 2025-09-06
 * 09-12 - 브라우저 번들러 해석(ESNext/Bundler), noEmit/Next 플러그인 추가, include 정리
 * 09-17 - TypeScript 컴파일 에러 해결을 위한 설정 추가
 * 10-07 - dist 기반 workspace 패키지(@connectwon/*) 경로 추가
 * 10-09 - Docker / Cloud Run / Firebase / Azure / Local 완전 호환 버전 (NodeNext 모듈 규칙 통일)
 */
{
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    // Next.js가 빌드/트랜스파일 처리 → TS는 타입체크 전용
    "noEmit": true,

    // NodeNext 조합 (패키지 exports 해석)
    "target": "es2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // Next가 JSX 변환 담당 → preserve
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],

    // Web 전용 baseUrl 및 경로 alias (루트 기준)
    "baseUrl": ".",
    "paths": {
      "@connectwon/core": [
        "../../dist/packages/core/index.d.ts",
        "../../dist/packages/core/index.js"
      ],
      "@connectwon/core/*": ["../../dist/packages/core/*"],

      "@connectwon/configs": [
        "../../dist/packages/configs/index.d.ts",
        "../../dist/packages/configs/index.js"
      ],
      "@connectwon/configs/*": ["../../dist/packages/configs/*"],

      "@connectwon/logger": [
        "../../dist/packages/logger/index.d.ts",
        "../../dist/packages/logger/index.js"
      ],
      "@connectwon/logger/*": ["../../dist/packages/logger/*"],

      "@connectwon/client": [
        "../../dist/packages/client/index.d.ts",
        "../../dist/packages/client/index.js"
      ],
      "@connectwon/client/*": ["../../dist/packages/client/*"],

      "@connectwon/ui": [
        "../../dist/packages/ui/index.d.ts",
        "../../dist/packages/ui/index.js"
      ],
      "@connectwon/ui/*": ["../../dist/packages/ui/*"],

      "@connectwon/sdk": [
        "../../dist/packages/sdk/index.d.ts",
        "../../dist/packages/sdk/index.js"
      ],
      "@connectwon/sdk/*": ["../../dist/packages/sdk/*"],

      "@connectwon/api-contract": [
        "../../dist/packages/api-contract/index.d.ts",
        "../../dist/packages/api-contract/index.js"
      ],
      "@connectwon/api-contract/*": ["../../dist/packages/api-contract/*"],

      // Web 전용 로컬 alias (src 기준)
      "components/*": ["src/components/*"],
      "data/*": ["src/data/*"],
      "lib/*": ["src/lib/*"]
    },

    // DOM 및 ES2022 API 사용
    "lib": ["dom", "dom.iterable", "es2022"],
    "types": ["node"],

    // 호환성 옵션
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    // Strict 설정
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "incremental": true,
    "tsBuildInfoFile": "./.next/.tsbuildinfo"
  },

  "include": [
    "src/next-env.d.ts",
    "src/web-types.d.ts",
    "src/**/*",
    "ui.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".next", "out"]
}
