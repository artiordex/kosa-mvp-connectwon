{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "description": "Nx 워크스페이스 설정",
  "extends": "nx/presets/npm.json",
  "defaultBase": "main",
  "__comment_namedInputs": "namedInputs: 빌드 캐시와 의존성 관리를 위한 입력 파일 집합을 정의",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/dist/**/*",
      "!{projectRoot}/build/**/*",
      "!{projectRoot}/.next/**/*"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.spec.tsx",
      "!{projectRoot}/**/*.test.tsx",
      "!{projectRoot}/**/*.stories.*",
      "!{projectRoot}/**/*.mdx",
      "!{projectRoot}/playwright-report/**",
      "!{projectRoot}/coverage/**",
      "!{projectRoot}/generated/**"
    ],
    "env": [
      "{workspaceRoot}/.env*",
      "{workspaceRoot}/infra/docker/.env",
      "{workspaceRoot}/secrets/**",
      "{projectRoot}/.env*"
    ]
  },
  "__comment_targetDefaults": "targetDefaults: Nx 작업 단위별 기본 입력, 출력, 캐싱, 의존성 등을 정의",
  "targetDefaults": {
    "build": {
      "inputs": [
        "production",
        "^production",
        "env"
      ],
      "outputs": [
        "{workspaceRoot}/dist",
        "{projectRoot}/.next"
      ],
      "cache": true,
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "inputs": [
        "default"
      ],
      "cache": false
    },
    "lint": {
      "inputs": [
        "default"
      ],
      "cache": true
    },
    "test": {
      "inputs": [
        "default",
        "^default"
      ],
      "cache": true
    },
    "e2e": {
      "inputs": [
        "default",
        "^production"
      ],
      "cache": false
    },
    "gen:openapi": {
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/openapi.json"
      ],
      "cache": true
    },
    "prisma:generate": {
      "inputs": [
        "default",
        "^default",
        "env"
      ],
      "cache": false
    },
    "db:generate": {
      "inputs": [
        "default",
        "^default",
        "env"
      ],
      "cache": false
    },
    "type-check": {
      "inputs": [
        "default",
        "^default"
      ],
      "cache": true
    },
    "format": {
      "inputs": [
        "default"
      ],
      "cache": false
    },
    "ci": {
      "inputs": [
        "production",
        "^production",
        "env"
      ],
      "cache": false
    }
  },
  "__comment_pluginsConfig": "pluginsConfig: Nx에서 사용하는 빌드와 검사 플러그인 지정",
  "pluginsConfig": {
    "@nx/js": {},
    "@nx/web": {}
  },
  "__comment_workspaceLayout": "workspaceLayout: 워크스페이스 내 앱과 라이브러리 디렉터리 구조 정의",
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "packages"
  },
  "nxCloudId": "68d17953ba8a6064f2ab0971"
}