{
  "dashboard": {
    "id": null,
    "title": "ConnectWon MVP - 통합 모니터링",
    "tags": ["connectwon", "mvp", "business"],
    "style": "dark",
    "timezone": "Asia/Seoul",
    "refresh": "30s",
    "time": { "from": "now-6h", "to": "now" },
    "templating": {
      "list": [
        {
          "name": "environment",
          "type": "custom",
          "options": [
            { "text": "Production", "value": "prod" },
            { "text": "Staging", "value": "staging" },
            { "text": "Development", "value": "dev" }
          ],
          "current": { "text": "Production", "value": "prod" }
        }
      ]
    },
    "panels": [
      {
        "id": 13,
        "title": "Frontend 상태 (Admin)",
        "type": "stat",
        "gridPos": { "h": 3, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "up{job=\"connectwon-admin\"}",
            "legendFormat": "Admin App",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bool",
            "mappings": [
              { "type": "value", "options": { "0": { "text": "🔴 DOWN", "color": "red" } } },
              { "type": "value", "options": { "1": { "text": "🟢 UP", "color": "green" } } }
            ]
          }
        },
        "options": { "colorMode": "background" }
      },
      {
        "id": 13,
        "title": "Frontend 상태 (Web)",
        "type": "stat",
        "gridPos": { "h": 3, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "up{job=\"connectwon-web\"}",
            "legendFormat": "Web App",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bool",
            "mappings": [
              { "type": "value", "options": { "0": { "text": "🔴 DOWN", "color": "red" } } },
              { "type": "value", "options": { "1": { "text": "🟢 UP", "color": "green" } } }
            ]
          }
        },
        "options": { "colorMode": "background" }
      },
      {
        "id": 3,
        "title": "API 요청률 (RPS)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=\"connectwon-api\"}[5m])) by (method, route)",
            "legendFormat": "{{method}} {{route}}",
            "refId": "A"
          },
          {
            "expr": "sum(rate(http_requests_total{job=\"connectwon-api\"}[5m]))",
            "legendFormat": "Total RPS",
            "refId": "B"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "reqps" } }
      },
      {
        "id": 4,
        "title": "API 응답시간 분포",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"connectwon-api\"}[5m])))",
            "legendFormat": "p50 (중간값)",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"connectwon-api\"}[5m])))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"connectwon-api\"}[5m])))",
            "legendFormat": "p99 (최악)",
            "refId": "C"
          }
        ]
      },
      {
        "id": 11,
        "title": "Redis & Worker 큐 상태",
        "type": "timeseries",
        "gridPos": { "h": 6, "w": 24, "x": 0, "y": 11 },
        "targets": [
          {
            "expr": "redis_connected_clients or redis_clients_connected",
            "legendFormat": "Redis 연결 수",
            "refId": "A"
          },
          {
            "expr": "worker_queue_waiting_jobs",
            "legendFormat": "대기 중인 작업",
            "refId": "B"
          },
          {
            "expr": "worker_queue_active_jobs",
            "legendFormat": "처리 중인 작업",
            "refId": "C"
          },
          {
            "expr": "rate(worker_jobs_completed_total[5m])",
            "legendFormat": "완료된 작업/초",
            "refId": "D"
          },
          {
            "expr": "rate(worker_jobs_failed_total[5m])",
            "legendFormat": "실패한 작업/초",
            "refId": "E"
          }
        ]
      },
      {
        "id": 10,
        "title": "PostgreSQL 상태",
        "type": "timeseries",
        "gridPos": { "h": 6, "w": 24, "x": 0, "y": 17 },
        "targets": [
          {
            "expr": "pg_stat_activity_count or postgresql_connections_active",
            "legendFormat": "활성 연결 수",
            "refId": "A"
          },
          {
            "expr": "rate(pg_stat_database_xact_commit[5m]) or rate(postgresql_transactions_total{type=\"commit\"}[5m])",
            "legendFormat": "초당 커밋 수",
            "refId": "B"
          },
          {
            "expr": "pg_stat_database_tup_inserted or rate(postgresql_rows_total{operation=\"insert\"}[5m])",
            "legendFormat": "초당 INSERT 수",
            "refId": "C"
          }
        ]
      },
      {
        "id": 8,
        "title": "시스템 리소스 - CPU",
        "type": "timeseries",
        "gridPos": { "h": 6, "w": 12, "x": 0, "y": 23 },
        "targets": [
          {
            "expr": "100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "legendFormat": "CPU 사용률 (%)",
            "refId": "A"
          }
        ]
      },
      {
        "id": 9,
        "title": "시스템 리소스 - 메모리",
        "type": "timeseries",
        "gridPos": { "h": 6, "w": 12, "x": 12, "y": 23 },
        "targets": [
          {
            "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
            "legendFormat": "메모리 사용률 (%)",
            "refId": "A"
          }
        ]
      }
    ],
    "annotations": {
      "list": [
        {
          "name": "배포 이벤트",
          "datasource": "prometheus",
          "enable": true,
          "expr": "deployment_timestamp",
          "iconColor": "rgba(0, 211, 255, 1)",
          "titleFormat": "배포: {{version}}",
          "textFormat": "{{description}}"
        }
      ]
    }
  },
  "overwrite": true,
  "inputs": [
    {
      "name": "DS_PROMETHEUS",
      "type": "datasource",
      "pluginId": "prometheus",
      "value": "prometheus"
    }
  ]
}
