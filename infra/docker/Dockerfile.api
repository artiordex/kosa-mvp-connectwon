# Description : Dockerfile.api - 📌 ConnectWon API (NestJS) 컨테이너 빌드
# Author : Shiwoo Min
# Date : 2025-09-15
# 09-16 - pnpm + 멀티스테이지 + distroless 런타임. tsc 경로 고정으로 TS5058 해결
# 09-17 - pnpm workspace 의존성 설치 오류 건 -> 전체 앱 package.json 복사 및 workspace 의존성 선빌드 추가

# 1. 공통 베이스 (Alpine + pnpm)
FROM node:22-alpine3.22 AS base
WORKDIR /app
# corepack(pnpm) 활성화 + glibc 호환 + 보안패키지 즉시 업데이트
RUN corepack enable && apk add --no-cache libc6-compat && apk upgrade --no-cache

# 2. 의존성 설치 - 전체 워크스페이스
FROM base AS deps
# 루트 워크스페이스 메타 파일
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml ./
# 내부 패키지들(공유 라이브러리)
COPY packages ./packages
# 모든 앱 package.json 복사
COPY apps/api/package.json ./apps/api/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY apps/admin/package.json ./apps/admin/package.json
COPY apps/worker/package.json ./apps/worker/package.json
COPY apps/e2e/package.json ./apps/e2e/package.json
# 전체 의존성 설치
RUN pnpm install --frozen-lockfile

# 3. 빌드
FROM deps AS build
# 전체 소스 복사
COPY . .

# workspace 의존성들 먼저 빌드
RUN pnpm --filter @connectwon/core build || true
RUN pnpm --filter @connectwon/database build || true
RUN pnpm --filter @connectwon/logger build || true
RUN pnpm --filter @connectwon/nest-kit build || true
RUN pnpm --filter @connectwon/ui build || true
RUN pnpm --filter @connectwon/api-contract build || true
RUN pnpm --filter @connectwon/sdk build || true

# API 앱 TypeScript 컴파일
RUN pnpm -w exec tsc -p apps/api/tsconfig.json

# 4. 런타임 (Distroless - node 22)
FROM gcr.io/distroless/nodejs22-debian12:nonroot AS runtime
WORKDIR /app
ENV NODE_ENV=production
# 실행에 필요한 최소 산출물만 복사
COPY --from=deps  /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/api      ./apps/api
EXPOSE 8000
CMD ["apps/api/dist/main.js"]
