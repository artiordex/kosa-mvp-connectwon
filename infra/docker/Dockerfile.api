# Description : Dockerfile.api - 📌 ConnectWon API (NestJS) 컨테이너 빌드
# Author : Shiwoo Min
# Date : 2025-09-23
# api 빌드: docker compose -p connectwon --env-file .env -f infra/docker/docker-compose.yml up -d --build api

# 1. 베이스 이미지
FROM node:22-alpine3.22 AS base
WORKDIR /app

# 필수 패키지 및 corepack 설정
RUN corepack enable \
  && apk add --no-cache libc6-compat ca-certificates bash \
  && apk upgrade --no-cache \
  && update-ca-certificates \
  && pnpm config set fetch-retries 6 \
  && pnpm config set fetch-retry-mintimeout 20000 \
  && pnpm config set fetch-retry-maxtimeout 600000 \
  && pnpm config set network-timeout 600000

# 2. 의존성 설치 단계
FROM base AS deps
WORKDIR /app

# 루트 메타데이터 먼저 복사 (락파일 포함) → 캐시 안정화
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json nx.json tsconfig.json tsconfig.base.json ./

# api가 사용하는 내부 패키지들의 package.json만 복사 (캐시 최적화)
COPY packages/api-contract/package.json packages/api-contract/
COPY packages/database/package.json     packages/database/
COPY packages/server/package.json       packages/server/
COPY packages/core/package.json         packages/core/
COPY packages/logger/package.json       packages/logger/
COPY apps/api/package.json              apps/api/

# pnpm install 시 filter로 범위 제한 → 락파일 불일치 오류 방지
RUN pnpm install --frozen-lockfile \
  --filter @connectwon/api-contract \
  --filter @connectwon/database \
  --filter @connectwon/server \
  --filter @connectwon/core \
  --filter @connectwon/logger \
  --filter @connectwon/api

  # 3. 빌드 단계
FROM deps AS build
WORKDIR /app

ENV NODE_ENV=production \
    NX_DAEMON=false \
    NX_CLOUD=false \
    NODE_OPTIONS="--max-old-space-size=4096"

# Prisma schema 먼저 복사
COPY packages/database/prisma ./packages/database/prisma
COPY packages ./packages
COPY apps/api ./apps/api

# Prisma Client 생성
RUN pnpm --filter @connectwon/database generate

# ------ 까지 성공

# API 빌드)
RUN pnpm nx build api

# 4. 런타임 단계
FROM gcr.io/distroless/nodejs22-debian12:nonroot AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    PORT=8000

# 빌드 결과물 복사
COPY --from=build /app/dist/apps/api ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json

EXPOSE 8000
CMD ["dist/main.js"]
