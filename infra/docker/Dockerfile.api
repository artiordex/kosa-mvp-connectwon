# Description : Dockerfile.api - 📌 ConnectWon API (NestJS) 컨테이너 빌드
# Author : Shiwoo Min
# Date : 2025-09-15
# 09-16 - pnpm + 멀티스테이지 + distroless 런타임. tsc 경로 고정으로 TS5058 해결

# 1. 공통 베이스 (Alpine + pnpm)
FROM node:22-alpine3.22 AS base
WORKDIR /app
# corepack(pnpm) 활성화 + glibc 호환 + 보안패키지 즉시 업데이트
RUN corepack enable && apk add --no-cache libc6-compat && apk upgrade --no-cache

# 2. 의존성 설치
FROM base AS deps
# 루트 워크스페이스 메타 파일
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml ./
# 내부 패키지들(공유 라이브러리)
COPY packages ./packages
# 앱 전용 package.json만 먼저 복사해서 의존성 그래프만 계산
COPY apps/api/package.json ./apps/api/package.json
# API 패키지 범위만 설치(캐시 효율 ↑)
RUN pnpm install --frozen-lockfile --filter=@connectwon/api

# 3. 빌드 (tsconfig 경로 명시)
FROM deps AS build
# 루트 tsconfig가 필요하면 함께 복사
COPY tsconfig.json tsconfig.base.json ./
# 실제 소스 복사
COPY apps/api ./apps/api
# TS5058 방지: 앱 내부 tsconfig.json을 명시적으로 지정
RUN pnpm -w exec tsc -p apps/api/tsconfig.json

# 4. 런타임 (Distroless - node 22)
FROM gcr.io/distroless/nodejs22-debian12:nonroot AS runtime
WORKDIR /app
ENV NODE_ENV=production
# 실행에 필요한 최소 산출물만 복사
COPY --from=deps  /app/node_modules ./node_modules
COPY --from=build /app/apps/api      ./apps/api
EXPOSE 8000
CMD ["apps/api/dist/main.js"]
