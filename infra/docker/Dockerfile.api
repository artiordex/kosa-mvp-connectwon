# Description : Dockerfile.api - 📌 ConnectWon API (NestJS) 컨테이너 빌드
# Author : Shiwoo Min
# Date : 2025-09-18
# 09-20 - deps 단계 전체 설치 + ESM 지원 + 의존성 디버깅
# 09-22 - pnpm deploy 도입: 런타임 의존성 누락/링크 깨짐 방지
# 09-23 - deploy 경로 충돌 해결: apps/api 디렉토리 비우기
# api 빌드: docker compose -p connectwon --env-file .env -f infra/docker/docker-compose.yml up -d --build api

# 1. 베이스 이미지
FROM node:22-alpine3.22 AS base
WORKDIR /app
RUN corepack enable \
  && apk add --no-cache libc6-compat ca-certificates \
  && apk upgrade --no-cache \
  && update-ca-certificates \
  && pnpm config set fetch-retries 6 \
  && pnpm config set fetch-retry-mintimeout 20000 \
  && pnpm config set fetch-retry-maxtimeout 600000 \
  && pnpm config set network-timeout 600000

# 2. 의존성 설치 단계
FROM base AS deps
WORKDIR /app

# 루트 메타데이터 먼저 복사 (락파일 포함)
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json nx.json tsconfig.json tsconfig.base.json ./

# api가 사용하는 내부 패키지들의 package.json만 복사 (캐시 최적화)
COPY packages/api-contract/package.json packages/api-contract/
COPY packages/database/package.json     packages/database/
COPY packages/server/package.json       packages/server/
COPY packages/core/package.json         packages/core/
COPY packages/logger/package.json       packages/logger/
COPY packages/configs/package.json      packages/configs/
COPY packages/sdk/package.json          packages/sdk/
COPY apps/api/package.json              apps/api/

# pnpm install 시 filter로 범위 제한 → 락파일 불일치 오류 방지
RUN pnpm install --frozen-lockfile \
  --filter @connectwon/api-contract \
  --filter @connectwon/database \
  --filter @connectwon/server \
  --filter @connectwon/core \
  --filter @connectwon/logger \
  --filter @connectwon/configs \
  --filter @connectwon/sdk \
  --filter @connectwon/api

# 3. 빌드 단계
FROM deps AS build
WORKDIR /app
COPY packages ./packages
COPY apps/api ./apps/api
ENV NODE_ENV=production
# NX 빌드 (project.json의 build 설정을 따름)
RUN pnpm nx run @connectwon/api:build

# 4. 런타임 단계 (Distroless)
FROM deps AS deploy
WORKDIR /app

# deploy 경로 비우기 (pnpm deploy는 빈 디렉토리만 허용)
RUN rm -rf ./apps/api && mkdir -p ./apps/api

# deploy 실행
RUN pnpm deploy --filter @connectwon/api --prod ./apps/api

# 5. 런타임 단계: 슬림 런타임 이미지
FROM node:22-alpine3.22 AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    PORT=8000

# deploy 산출물: 정확한 node_modules + package.json
COPY --from=deploy /app/node_modules ./node_modules
COPY --from=deploy /app/package.json ./package.json

# 빌드 산출물 복사 (루트 dist 사용)
COPY --from=build /app/dist ./dist

EXPOSE 8000
CMD ["node", "dist/main.js"]
