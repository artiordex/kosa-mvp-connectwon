# Description : Dockerfile.api - 📌 ConnectWon API (NestJS) 컨테이너 빌드
# Author : Shiwoo Min
# Date : 2025-09-23
# api 빌드: docker compose -p connectwon --env-file .env -f infra/docker/docker-compose.yml up -d --build api

# 1. 베이스 이미지
FROM node:22-alpine3.22 AS base
WORKDIR /app

# 필수 패키지만 설치
RUN corepack enable \
  && apk add --no-cache libc6-compat ca-certificates \
  && apk upgrade --no-cache

# PNPM 최적화 설정
RUN pnpm config set fetch-retries 2 \
  && pnpm config set network-timeout 30000 \
  && pnpm config set registry https://registry.npmjs.org/

# 2. 의존성 설치 단계
FROM base AS deps
WORKDIR /app

# 워크스페이스 파일들 복사
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json nx.json tsconfig.base.json ./

# API 관련 package.json만 복사
COPY packages/api-contract/package.json packages/api-contract/
COPY packages/database/package.json     packages/database/
COPY packages/server/package.json       packages/server/
COPY packages/core/package.json         packages/core/
COPY packages/logger/package.json       packages/logger/
COPY packages/configs/package.json      packages/configs/
COPY packages/sdk/package.json          packages/sdk/
COPY apps/api/package.json              apps/api/

# 필터된 의존성 설치 (로그 최소화)
RUN pnpm install --frozen-lockfile \
    --filter @connectwon/api-contract \
    --filter @connectwon/database \
    --filter @connectwon/server \
    --filter @connectwon/core \
    --filter @connectwon/logger \
    --filter @connectwon/configs \
    --filter @connectwon/sdk \
    --filter @connectwon/api \
    --reporter=silent

# 3. 빌드 단계
FROM deps AS build

WORKDIR /app

# 소스 코드 복사
COPY packages ./packages
COPY apps/api ./apps/api

ENV NODE_ENV=production

# 전체 의존성 설치 (로그 최소화)
RUN pnpm install --frozen-lockfile --reporter=silent

# API 빌드 실행 (로그 최소화)
RUN pnpm --filter @connectwon/api build --reporter=silent

# 4. 런타임 단계
FROM node:22-alpine3.22 AS runtime

WORKDIR /app

ENV NODE_ENV=production \
    PORT=8000

# 런타임 패키지 설치
RUN apk add --no-cache ca-certificates dumb-init \
  && apk upgrade --no-cache

# 빌드 결과물 복사
COPY --from=build /app/dist/apps/api ./dist
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/pnpm-lock.yaml ./pnpm-lock.yaml

# 런타임 의존성 설치
RUN corepack enable \
  && pnpm install --prod --frozen-lockfile --reporter=silent \
  && rm -rf ~/.pnpm-store

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8000/health || exit 1

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "dist/main.js"]
