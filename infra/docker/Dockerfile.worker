# Description : Dockerfile.worker - 📌 ConnectWon Worker 빌드/런타임
# Author : Shiwoo Min
# Date : 2025-09-18
# 09-20 - deps 단계 filter 설치 + Distroless 런타임
# worker 빌드: docker compose -p connectwon --env-file .env -f infra/docker/docker-compose.yml up -d --build worker

# 1. 베이스 이미지
FROM node:22-alpine3.22 AS base
WORKDIR /app
RUN corepack enable \
  && apk add --no-cache libc6-compat ca-certificates \
  && apk upgrade --no-cache \
  && update-ca-certificates \
  && pnpm config set fetch-retries 3 \
  && pnpm config set network-timeout 60000

# 2. 의존성 설치 단계
FROM base AS deps
WORKDIR /app

# 루트 메타데이터 먼저 복사
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json nx.json tsconfig.json tsconfig.base.json ./

# worker가 의존하는 내부 패키지들의 package.json만 복사 (database 제외)
COPY packages/api-contract/package.json packages/api-contract/
COPY packages/client/package.json       packages/client/
COPY packages/server/package.json       packages/server/
COPY packages/sdk/package.json          packages/sdk/
COPY packages/core/package.json         packages/core/
COPY packages/logger/package.json       packages/logger/
COPY packages/configs/package.json      packages/configs/
COPY apps/worker/package.json           apps/worker/

# database 패키지 제외하고 설치
RUN pnpm install --no-frozen-lockfile \
  --filter @connectwon/api-contract \
  --filter @connectwon/client \
  --filter @connectwon/server \
  --filter @connectwon/sdk \
  --filter @connectwon/core \
  --filter @connectwon/logger \
  --filter @connectwon/configs \
  --filter @connectwon/worker

# 3. 빌드 단계
FROM deps AS build
WORKDIR /app

# 소스 코드 복사 (database 제외)
COPY packages ./packages
COPY apps/worker ./apps/worker

# Nx 빌드
RUN pnpm nx run @connectwon/worker:build

# 4. 런타임 단계 (Distroless)
FROM gcr.io/distroless/nodejs22-debian12:nonroot AS runtime
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/dist/apps/worker ./dist/apps/worker

CMD ["dist/apps/worker/main.js"]
