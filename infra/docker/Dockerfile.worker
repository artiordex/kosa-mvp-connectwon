# Description : Dockerfile.worker - 📌 ConnectWon Worker (Background Jobs)
# Author : Shiwoo Min
# Date : 2025-09-15
# 09-16 - CI에서 Nx 플러그인(@nx/node) 미탐색 이슈 → 패키지 스크립트 빌드로 단순화

# 1. 공통 베이스
FROM node:22-alpine3.22 AS base
WORKDIR /repo
RUN corepack enable && apk add --no-cache libc6-compat && apk upgrade --no-cache

# 2. 의존성 설치
FROM base AS deps
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml nx.json ./
COPY packages ./packages
COPY apps/worker/package.json ./apps/worker/package.json
# worker만 설치
RUN pnpm install --frozen-lockfile --filter=@connectwon/worker

# 3. 빌드 (Nx → 패키지 스크립트)
FROM deps AS build
COPY . .
# package.json에 "build": "tsc -p apps/worker/tsconfig.json" 형태가 있어야 함
RUN pnpm --filter @connectwon/worker build

# 4. 런타임 (Distroless)
FROM gcr.io/distroless/nodejs22-debian12:nonroot AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps  /repo/node_modules ./node_modules
COPY --from=build /repo/apps/worker   ./apps/worker
# 엔트리 경로
CMD ["apps/worker/dist/main.js"]
