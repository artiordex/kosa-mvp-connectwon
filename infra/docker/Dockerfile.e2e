# Description : Dockerfile.e2e - 📌 ConnectWon E2E 테스트 (Playwright) 컨테이너 빌드
# Author : Shiwoo Min
# Date : 2025-09-18

# 1. Playwright 공식 베이스 이미지
FROM mcr.microsoft.com/playwright:v1.51.1-jammy
WORKDIR /app

# 2. 의존성 설치
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml nx.json ./
COPY packages ./packages
COPY apps/*/package.json ./apps/
RUN corepack enable && pnpm install --frozen-lockfile

# 3. E2E 소스 복사
COPY apps/e2e ./apps/e2e

# 4. Playwright 브라우저 설치
RUN npx playwright install --with-deps

# 5. 환경 변수 설정
ENV CI=true \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# 6. 결과 디렉토리 생성
RUN mkdir -p ./apps/e2e/test-results && chmod 777 ./apps/e2e/test-results

# 7. 테스트 실행 (헬스체크 없음)
CMD ["pnpm", "--filter", "@connectwon/e2e", "test"]
