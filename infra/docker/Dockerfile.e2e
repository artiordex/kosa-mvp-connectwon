# Description : Dockerfile.e2e - 📌 ConnectWon E2E 테스트 (Playwright) 컨테이너 빌드
# Author : Shiwoo Min
# Date : 2025-09-16
# 09-16 - Playwright 공식 이미지 + pnpm + 네트워크 격리 환경에서 실행 가능하도록 설계

# 1. Playwright 공식 베이스 이미지
FROM mcr.microsoft.com/playwright:v1.44.0-focal AS base
WORKDIR /app

# pnpm 설치
RUN npm install -g pnpm@latest

# 1. 워크스페이스 설정 먼저
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages ./packages
COPY apps/e2e/package.json ./apps/e2e/package.json

# 2. 의존성 설치
RUN pnpm install --frozen-lockfile

# 3. E2E 소스 복사
COPY apps/e2e ./apps/e2e

# 4. Playwright 브라우저 설치
RUN npx playwright install --with-deps

# 환경 변수
ENV CI=true \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# 결과 디렉토리
RUN mkdir -p ./apps/e2e/test-results && chmod 777 ./apps/e2e/test-results

# 헬스체크 제거 (E2E는 일회성 실행)
# HEALTHCHECK 삭제

CMD ["pnpm", "--filter", "@connectwon/e2e", "test"]
