# Description : Dockerfile.admin - 📌 ConnectWon Admin (Next.js) 컨테이너 빌드
# Author : Shiwoo Min
# Date : 2025-09-18

# 1. 베이스 이미지
FROM node:22-alpine3.22 AS base
WORKDIR /app
RUN corepack enable && apk add --no-cache libc6-compat && apk upgrade --no-cache

# 2. 의존성 설치 단계
FROM base AS deps
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml nx.json ./
COPY packages ./packages
COPY apps/admin/package.json ./apps/admin/package.json

# 워크스페이스 전체 설치 후 개별 앱 의존성 재설치
RUN pnpm install --frozen-lockfile && \
    cd apps/admin && \
    pnpm install && \
    ls -la node_modules | grep next-auth || echo "next-auth not found in local node_modules" && \
    ls -la ../../../node_modules | grep next-auth || echo "next-auth not found in root node_modules"

# 3. 빌드 단계
FROM deps AS build
COPY apps/admin ./apps/admin
COPY packages ./packages
COPY tsconfig.* ./
COPY nx.json pnpm-workspace.yaml package.json pnpm-lock.yaml ./

# 빌드 환경변수 설정
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN pnpm --filter @connectwon/admin build

# 4. 런타임 단계
FROM gcr.io/distroless/nodejs22-debian12:nonroot AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps  /app/node_modules ./node_modules
COPY --from=deps  /app/apps/admin/node_modules ./apps/admin/node_modules
COPY --from=build /app/apps/admin/.next ./apps/admin/.next
COPY --from=build /app/apps/admin/package.json ./apps/admin/package.json
EXPOSE 3001
CMD ["apps/admin/node_modules/.bin/next", "start", "-p", "3001"]
