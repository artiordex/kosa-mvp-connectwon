# Description : Dockerfile.admin - 📌 ConnectWon Admin (Next.js) 컨테이너 빌드
# Author : Shiwoo Min
# Date : 2025-09-20
# 09-20 - deps 단계 filter 설치 + Distroless 런타임
# admin 빌드: docker compose -p connectwon --env-file .env -f infra/docker/docker-compose.yml up -d --build admin

# 1. 베이스 이미지
FROM node:22-alpine3.22 AS base
WORKDIR /app
RUN corepack enable \
  && apk add --no-cache libc6-compat ca-certificates \
  && apk upgrade --no-cache \
  && update-ca-certificates \
  && pnpm config set fetch-retries 6 \
  && pnpm config set fetch-retry-mintimeout 20000 \
  && pnpm config set fetch-retry-maxtimeout 600000 \
  && pnpm config set network-timeout 600000

# 2. 의존성 설치 단계
FROM base AS deps
WORKDIR /app

# 루트 메타데이터 먼저 복사 (락파일 포함)
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json nx.json tsconfig.json tsconfig.base.json ./

# admin이 사용하는 내부 패키지들의 package.json만 복사 (캐시 최적화)
COPY packages/api-contract/package.json packages/api-contract/
COPY packages/ui/package.json            packages/ui/
COPY packages/client/package.json        packages/client/
COPY packages/sdk/package.json           packages/sdk/
COPY apps/admin/package.json             apps/admin/

# pnpm install 시 filter로 범위 제한 → 락파일 불일치 오류 방지
RUN pnpm install --frozen-lockfile \
  --filter @connectwon/api-contract \
  --filter @connectwon/ui \
  --filter @connectwon/client \
  --filter @connectwon/sdk \
  --filter @connectwon/admin

# 3. 빌드 단계
FROM deps AS build
WORKDIR /app
COPY packages ./packages
COPY apps/admin ./apps/admin

# Next.js 빌드
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @connectwon/admin build

# 4. 런타임 단계 (Distroless)
FROM gcr.io/distroless/nodejs22-debian12:nonroot AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3001

# Next standalone 산출물만 복사
COPY --from=build /app/apps/admin/.next/standalone ./
COPY --from=build /app/apps/admin/public ./apps/admin/public
COPY --from=build /app/apps/admin/.next/static ./apps/admin/.next/static

EXPOSE 3001
CMD ["apps/admin/server.js"]
