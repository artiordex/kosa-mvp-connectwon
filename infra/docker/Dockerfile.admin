# Description : Dockerfile.admin - 📌 ConnectWon Admin (Next.js) 컨테이너 빌드
# Author : Shiwoo Min
# Date : 2025-09-20
# admin 빌드: docker compose -p connectwon --env-file .env -f infra/docker/docker-compose.yml up -d --build admin

# 1. 베이스 이미지
FROM node:22-alpine3.22 AS base
WORKDIR /app

# 필수 패키지 및 corepack 설정
RUN corepack enable \
  && apk add --no-cache libc6-compat ca-certificates git openssh bash \
  && apk upgrade --no-cache \
  && update-ca-certificates \
  && pnpm config set fetch-retries 6 \
  && pnpm config set fetch-retry-mintimeout 20000 \
  && pnpm config set fetch-retry-maxtimeout 600000 \
  && pnpm config set network-timeout 600000

# 2. 의존성 설치 단계
FROM base AS deps
WORKDIR /app

# 루트 메타데이터 복사 (락파일 포함)
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json nx.json tsconfig.json tsconfig.base.json ./

# 모든 패키지 package.json 복사 (workspace 링크 유지)
COPY packages/*/package.json packages/*/
COPY apps/*/package.json apps/*/

# pnpm install (전체 workspace 링크 유지)
# --prod=false : devDependencies 포함 (E2E/빌드 대응)
RUN pnpm install --no-frozen-lockfile --prod=false

# ✅ UI/Client 패키지의 peerDependencies 강제 설치 (Docker 내부 빌드용)
RUN pnpm add -w recharts clsx class-variance-authority tailwind-merge @tanstack/react-query next-auth

# 3. 빌드 단계
FROM deps AS build
WORKDIR /app

# 전체 소스 복사
COPY packages ./packages
COPY apps ./apps

# 내부 패키지 dist 빌드 후 admin 빌드
RUN pnpm nx run-many -t build \
  --projects=@connectwon/ui,@connectwon/client \
  --parallel --skip-nx-cache \
  --exclude=@connectwon/api-contract,@connectwon/configs && \
  # 빌드 후 dist를 node_modules에 링크
  pnpm link --dir apps/admin @connectwon/ui @connectwon/client && \
  pnpm --filter @connectwon/admin build

# 4. 런타임 단계 (Distroless)
FROM gcr.io/distroless/nodejs22-debian12:nonroot AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    PORT=8080 \
    HOST=0.0.0.0

# Next.js standalone 산출물 복사
COPY --from=build /app/apps/admin/.next/standalone ./
COPY --from=build /app/apps/admin/public ./public
COPY --from=build /app/apps/admin/.next/static ./.next/static

EXPOSE 8080
CMD ["server.js"]
