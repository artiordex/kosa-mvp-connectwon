# Description : Dockerfile.admin - 📌 ConnectWon Admin (Next.js) 빌드/런타임
# Author : Shiwoo Min
# Date : 2025-09-15
# 09-16 - 기존 오류 (FROM base 정의 누락, Next.js 모듈 경로 문제 해결) 수정
# 09-17 - pnpm workspace 의존성 설치 오류 건 -> 전체 앱 package.json 복사 및 workspace 의존성 선빌드 추가

# 1. 공통 베이스
FROM node:22-alpine3.22 AS base
WORKDIR /app
RUN corepack enable && apk add --no-cache libc6-compat && apk upgrade --no-cache

# 2. 의존성 설치 - 전체 워크스페이스
FROM base AS deps
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml tsconfig.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/admin/package.json ./apps/admin/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY apps/api/package.json ./apps/api/package.json
COPY apps/worker/package.json ./apps/worker/package.json
COPY apps/e2e/package.json ./apps/e2e/package.json
# 전체 의존성 설치
RUN pnpm install --frozen-lockfile

# 3. 빌드
FROM deps AS build
COPY . .
ENV NEXT_DISABLE_ESLINT=1 \
    NEXT_TELEMETRY_DISABLED=1 \
    TSC_COMPILE_ON_ERROR=true

# workspace 의존성들 먼저 빌드 (필요시)
RUN pnpm --filter @connectwon/ui build || true
RUN pnpm --filter @connectwon/api-contract build || true
RUN pnpm --filter @connectwon/sdk build || true

# Admin 앱 빌드
RUN pnpm --filter @connectwon/admin build

# 4. 런타임 (Next standalone)
FROM node:22-alpine3.22 AS runner
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3001
COPY --from=build /app/apps/admin/.next/standalone ./
COPY --from=build /app/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=build /app/apps/admin/public      ./apps/admin/public
EXPOSE 3001
CMD ["node", "apps/admin/server.js"]
