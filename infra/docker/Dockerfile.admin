# Description : Dockerfile.admin - 📌 관리자 대시보드 빌드 설정
# Author : Shiwoo Min
# Date : 2025-09-07
# 09-15 - 버전 고정(corepack prepare pnpm@...) 제거 → package.json의 packageManager(10.7.0) 준수

# Node.js 20 Alpine 베이스 이미지
FROM node:20.12.0-alpine3.20 AS base

# 패키지 매니저 설정
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

# 작업 디렉토리 설정
WORKDIR /app

# 의존성 설치 단계
FROM base AS deps
# 루트의 패키지 파일들 복사
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# apps/admin 패키지 파일 복사
COPY apps/admin/package.json ./apps/admin/
# packages 디렉토리 복사 (공통 패키지들)
COPY packages ./packages
# 의존성 설치 (관리자 앱만)
RUN pnpm install --frozen-lockfile --filter=admin

# 빌드 단계
FROM base AS builder
WORKDIR /app
# 의존성 복사
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/admin/node_modules ./apps/admin/node_modules
COPY --from=deps /app/packages ./packages
# 소스 코드 복사
COPY apps/admin ./apps/admin
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# 관리자 앱 빌드
RUN pnpm build --filter=admin

# 프로덕션 실행 단계
FROM base AS runner
WORKDIR /app

# 프로덕션 의존성만 설치
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/admin/package.json ./apps/admin/
COPY packages ./packages
RUN pnpm install --frozen-lockfile --filter=admin --prod

# 빌드 결과물 복사
COPY --from=builder /app/apps/admin/.next ./apps/admin/.next
COPY --from=builder /app/apps/admin/public ./apps/admin/public
COPY --from=builder /app/apps/admin/next.config.js ./apps/admin/
COPY --from=builder /app/apps/admin/package.json ./apps/admin/

# 실행 사용자 설정
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs
USER nextjs

# 포트 노출
EXPOSE 3001

# 작업 디렉토리를 admin으로 변경
WORKDIR /app/apps/admin

# Next.js 시작
CMD ["pnpm", "start"]
