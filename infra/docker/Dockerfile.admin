# Description : Dockerfile.admin - 📌 ConnectWon Admin (Next.js) 컨테이너 빌드
# Author : Shiwoo Min
# Date : 2025-09-15
# 09-16 - 기존 오류 (FROM base 정의 누락, Next.js 모듈 경로 문제 해결) 수정
# 09-17 - pnpm workspace 의존성 설치 오류 건 -> 전체 앱 package.json 복사 및 workspace 의존성 선빌드 추가

# 1. 공통 베이스
FROM node:22-alpine3.22 AS base
WORKDIR /app
RUN corepack enable && apk add --no-cache libc6-compat && apk upgrade --no-cache

# 2. 의존성 설치 - 전체 워크스페이스
FROM base AS deps
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml nx.json ./
COPY packages ./packages
# 모든 앱의 package.json을 한 번에 복사
COPY apps/*/package.json ./apps/
RUN pnpm install --frozen-lockfile

# 3. 빌드
FROM deps AS build
COPY . .
RUN pnpm --filter @connectwon/admin build

# 4. 런타임 (Next standalone)
FROM gcr.io/distroless/nodejs22-debian12:nonroot AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps  /app/node_modules ./node_modules
COPY --from=build /app/apps/admin/.next ./apps/admin/.next
COPY --from=build /app/apps/admin/package.json ./apps/admin/package.json
EXPOSE 3001
CMD ["apps/admin/node_modules/.bin/next", "start", "-p", "3001"]
