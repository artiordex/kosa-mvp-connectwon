# Description : Dockerfile.web - 📌 ConnectWon Web (Next.js) 컨테이너 빌드
# Author : Shiwoo Min
# Date : 2025-09-18
# 09-20 - deps 단계 filter 설치 + Distroless 런타임
# web 빌드: docker compose -p connectwon --env-file .env -f infra/docker/docker-compose.yml up -d --build web

# 1. 베이스 이미지
FROM node:22-alpine3.22 AS base
WORKDIR /app
# corepack 유지 (pnpm 버전 관리) + 필수 라이브러리
RUN corepack enable && apk add --no-cache libc6-compat && apk upgrade --no-cache

# 2. 의존성 설치 단계
FROM base AS deps
WORKDIR /app

# 루트 메타데이터 먼저 복사 (락파일 포함) → 캐시 안정화
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json nx.json tsconfig.json tsconfig.base.json ./

# web이 사용하는 내부 패키지들의 package.json만 복사 (캐시 최적화)
COPY packages/api-contract/package.json packages/api-contract/
COPY packages/ui/package.json            packages/ui/
COPY packages/client/package.json        packages/client/
COPY packages/sdk/package.json           packages/sdk/
COPY apps/web/package.json               apps/web/

# pnpm install 시 filter로 범위 제한 → 락파일 불일치 오류 방지
RUN pnpm install --frozen-lockfile \
  --filter @connectwon/api-contract \
  --filter @connectwon/ui \
  --filter @connectwon/client \
  --filter @connectwon/sdk \
  --filter @connectwon/web

# 3. 빌드 단계
FROM deps AS build
WORKDIR /app

# 실제 소스 복사
COPY packages ./packages
COPY apps/web ./apps/web

# Next.js 빌드 (standalone 산출)
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @connectwon/web build

# 4. 런타임 단계 (Distroless)
FROM gcr.io/distroless/nodejs22-debian12:nonroot AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000

# Next standalone 산출물만 복사
# - .next/standalone: 실행에 필요한 최소 node_modules + server.js
# - public: 정적 자산
# - .next/static: 정적 번들
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/public ./apps/web/public
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static

EXPOSE 3000
# Distroless: node 엔트리포인트가 있으므로 실행 스크립트만 지정
CMD ["apps/web/server.js"]
