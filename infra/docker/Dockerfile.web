# Description : Dockerfile.web - 📌 ConnectWon Web (Next.js) 빌드/런타임
# Author : Shiwoo Min
# Date : 2025-09-18

# 1. 공통 베이스
FROM node:22-alpine3.22 AS base
WORKDIR /app
RUN corepack enable && apk add --no-cache libc6-compat && apk upgrade --no-cache

# 2. 의존성 설치
FROM base AS deps
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml nx.json ./
COPY packages ./packages
COPY apps/web/package.json ./apps/web/package.json
RUN pnpm install --frozen-lockfile

# 3. 빌드
FROM deps AS build
COPY apps/web ./apps/web
COPY packages ./packages
COPY tsconfig.* ./
COPY nx.json pnpm-workspace.yaml package.json pnpm-lock.yaml ./
# 빌드 환경변수 설정 (프리렌더링 문제 해결)
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PRIVATE_SKIP_VALIDATION=1
ENV CI=true
RUN pnpm --filter @connectwon/web build

# 4. 런타임 (Next standalone)
FROM gcr.io/distroless/nodejs22-debian12:nonroot AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps  /app/node_modules ./node_modules
COPY --from=build /app/apps/web/.next ./apps/web/.next
COPY --from=build /app/apps/web/package.json ./apps/web/package.json
EXPOSE 3000
CMD ["apps/web/node_modules/.bin/next", "start", "-p", "3000"]
